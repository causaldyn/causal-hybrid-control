/* What a grid of nodes cannot see: a barrier that meets the condition at every node of a grid,
   fails it between them, and is not forward invariant.

   Setting (chc.reachability.barrier_reachability_gap, higher_order_barrier_gap). Both read the
   robust barrier condition, residual = grad h . f + U (||B' grad h|| - radius ||grad h||)_+
   + alpha h >= 0, at the nodes of a uniform grid, and solve the tube on the same nodes. Here the
   grid is [-1, 1]^2 with 21 nodes a side, spacing 1/10; the drift is f = (1, 0), B = 0, so the
   control term is 0, alpha = 1; and

       h(x) = 1 - 4 phi(x),   phi(x) = exp(-1/(1 - s)) where s = |x - c|^2/w^2 < 1, else 0,

   a smooth bump of radius w = 1/25 about c = (1/20, 1/20), the centre of the cell [0, 1/10]^2.

     STEP 1  the bump's support lies inside the open cell and away from every node, so h = 1 on a
             neighbourhood of each node: its value and every derivative there are those of h = 1,
             whose residual is alpha > 0. Nothing read at the nodes tells the two apart, a slope
             of the residual included.
     STEP 2  the residual at x_t = c - (w/2, 0), between nodes: 1 - (1636/9) exp(-4/3) < 0.
     STEP 3  h(c) = 1 - 4/e < 0, and the state c - (w, 0), where h = 1 (and psi1 = grad h . f
             + h = 1, so it is in the higher-order working set too), reaches c at t = w under f.
             Neither {h >= 0} nor the working set is forward invariant.
*/
display2d : false$
fpprec : 30$
w : 1/25$
c : [1/20, 1/20]$
spacing : 1/10$
verdict(ok) := if ok then "(holds)" else "(FAIL)"$

print("=== STEP 1: the support sits inside one cell, away from the nodes ===")$
edge_gap : min(c[1] - 0, spacing - c[1], c[2] - 0, spacing - c[2])$
print("STEP 1a distance from c to the cell's edges =", edge_gap, " radius w =", w,
      verdict(is(edge_gap > w)))$
/* the nearest nodes are the cell's corners */
corner : sqrt((c[1] - 0)^2 + (c[2] - 0)^2)$
print("STEP 1b distance from c to the nearest node =", corner, " =", bfloat(corner),
      verdict(is(corner > w)))$

print("=== STEP 2: the residual between nodes ===")$
s(x1, x2) := ((x1 - c[1])^2 + (x2 - c[2])^2)/w^2$
phi(x1, x2) := exp(-1/(1 - s(x1, x2)))$          /* inside the support */
h_in(x1, x2) := 1 - 4*phi(x1, x2)$
residual_in : diff(h_in(x1, x2), x1)*1 + diff(h_in(x1, x2), x2)*0 + 1*h_in(x1, x2)$
xt : [c[1] - w/2, c[2]]$
r_t : ratsimp(subst([x1 = xt[1], x2 = xt[2]], residual_in))$
print("STEP 2a s at x_t =", subst([x1 = xt[1], x2 = xt[2]], s(x1, x2)))$
print("STEP 2b residual at x_t =", r_t, " =", bfloat(r_t))$
print("STEP 2c against 1 - (1636/9) exp(-4/3):", ratsimp(r_t - (1 - 1636/9*exp(-4/3))),
      verdict(is(ratsimp(r_t - (1 - 1636/9*exp(-4/3))) = 0) and is(bfloat(r_t) < 0)))$

print("=== STEP 3: a hole in {h >= 0} the flow enters ===")$
h_c : subst([x1 = c[1], x2 = c[2]], h_in(x1, x2))$
print("STEP 3a h(c) =", h_c, " =", bfloat(h_c), verdict(is(bfloat(h_c) < 0)))$
x0 : [c[1] - w, c[2]]$
print("STEP 3b s at the start c - (w, 0) =", subst([x1 = x0[1], x2 = x0[2]], s(x1, x2)),
      " (on the support's rim, where phi and every derivative of it are 0: h = 1, psi1 = 1)")$
print("STEP 3c under f = (1, 0) the state reaches c at t =", c[1] - x0[1], verdict(is(c[1] - x0[1] = w)))$
