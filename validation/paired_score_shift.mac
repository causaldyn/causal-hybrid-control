/* The error of the move between two fits of one log, which chc.dynamics_id._spline_shift reads
   the default fit's nuisance check in.

   Both fits are linear in the rate they are handed: theta_p = b'y, theta_s = a'y, with weights a
   and b set by the covariates and the actions alone, and y = mu + eps, eps independent across
   rows with variances s_i^2. Where both fits are right, a'mu = b'mu, and the move is noise.

   STEP 1  Var(a'y - b'y) = sum (a_i - b_i)^2 s_i^2: the move's variance is the rows' paired
           weights squared, whatever the two fits' own variances are
   STEP 2  the paired score, (a_i e_i - b_i e_i)^2 at the noise itself, has that expectation; the
           plug-in reads each fit's own residual in place of e_i
   STEP 3  Hausman's Var(theta_s) - Var(theta_p) is the move's variance only where b is the
           efficient one, Cov(theta_s - theta_p, theta_p) = 0; otherwise it is short by twice that
           covariance, and can read below nothing
   STEP 4  an example where the default fit is not the efficient one: Hausman reads -15/8, the
           paired variance 19/8

   Run: timeout 300 maxima --very-quiet -Q -b validation/paired_score_shift.mac */

linel : 110$
display2d : false$

n : 3$
a : makelist(concat(a, i), i, 1, n)$
b : makelist(concat(b, i), i, 1, n)$
noise : makelist(concat(s, i)^2, i, 1, n)$

/* E[e_i e_j] = s_i^2 when i = j, else 0: the variance of a linear form in independent noise */
variance(w) := sum(w[i]^2 * noise[i], i, 1, n)$
covariance(w, v) := sum(w[i] * v[i] * noise[i], i, 1, n)$

move : a - b$
step1 : expand(variance(move) - (variance(a) + variance(b) - 2*covariance(a, b)))$
print("STEP 1  Var(a'e - b'e) - (Var a'e + Var b'e - 2 Cov):", step1,
      if step1 = 0 then "(PASS)" else "(FAIL)")$

/* each row's paired score squared, its noise e_i's square read at its variance */
e : makelist(concat(e, i), i, 1, n)$
paired : subst(makelist(e[i]^2 = noise[i], i, 1, n),
               expand(sum((a[i]*e[i] - b[i]*e[i])^2, i, 1, n)))$
step2 : expand(paired - variance(move))$
print("STEP 2  E sum (a_i e_i - b_i e_i)^2 - Var(move):", step2,
      if step2 = 0 then "(PASS)" else "(FAIL)")$

hausman : variance(a) - variance(b)$
step3 : expand(variance(move) - (hausman - 2*covariance(move, b)))$
print("STEP 3  Var(move) - (Hausman - 2 Cov(move, theta_p)):", step3,
      if step3 = 0 then "(PASS)" else "(FAIL)")$

/* one regressor, unit noise on rows 1 and 2, nine on row 3: the efficient weight on the third
   row is the smaller, and a default fit that weighs every row alike is not efficient */
example : [a1 = 1/2, a2 = 1/2, a3 = 0, b1 = 1/4, b2 = 1/4, b3 = 1/2, s1 = 1, s2 = 1, s3 = 3]$
hausman_example : subst(example, hausman)$
paired_example : subst(example, paired)$
print("STEP 4  Hausman", hausman_example, " paired", paired_example,
      if hausman_example < 0 and paired_example > 0 then "(PASS)" else "(FAIL)")$
