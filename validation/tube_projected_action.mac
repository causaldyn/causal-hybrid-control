/* The tube's field error at an action, priced from the log's projected action.

   An Euler fit reads the channel c by partialling out (Robinson 1988) and then the drift by least
   squares on the rate less the fitted channel's part: d = W (y - G c), W = (D'D)^-1 D' the drift
   regression's weight, D its design and G the channel's regressors on the log. The field at a
   state x and an action u is f = phi(x)' d + g(x, u)' c, so it moves with the noise by

       delta f = phi' W delta y + (g(x, u) - Gamma' phi(x))' delta c,     Gamma = W G:

   the drift's own error, the channel held, and the channel's error times the action's distance
   from Gamma' phi(x), what the drift's features predict of the logged actions at x, the log's
   projected action. Not its distance from the logged mean u_bar: up to 0.21.0 the tube read the
   channel's error at the distance from u_bar and the field's error at u_bar in quadrature.

   Checked here:
   (1) the decomposition, symbolically;
   (2) with least squares on [D, u], the field's variance at (x, u0) is the drift's own plus the
       channel's at the distance from the projected action: the leverage identity
       h' (X'X)^-1 h = phi' A^-1 phi + (u0 - phi' A^-1 v)^2 / (s - v' A^-1 v), symbolic, and with
       two channel columns g = u [1, x] the same by the Schur complement, at a rational point;
   (3) Frisch and Waugh (1933): under one noise variance the drift's own error and the channel's
       are uncorrelated, phi' W M' = 0, M the channel's weight on the rows, whenever the drift's
       design lies in the span the nuisances partial out;
   (4) the old reading against the exact one over the box u_bar +- w at a distance
       d = |u_bar - Gamma' phi| (one lever, the channel constant): the exact largest is (w + d)^2,
       the quadrature w^2 + d^2; their ratio is largest, 2, at w = d, sqrt 2 in standard deviation,
       and 1.251 in standard deviation at w = 2, d = 0.62; toward the projected action the
       quadrature reads more than the exact (w - d)^2;
   (5) the error's square is a convex quadratic in u, so its largest over a box is at a vertex: on
       two levers at a rational point, every point of a grid of the box against the four vertices.
*/
display2d : false$
ratprint : false$
/* a check that fails stops the batch with "-- an error.", which validation/run_all.sh reads */
vanishes(label, x) := if (if matrixp(x) then every(lambda([e], is(e = 0)), flatten(args(x)))
                          else is(x = 0))
  then print(label, "= 0") else error(label, "is not zero:", x)$
holds(label, claim) := if is(claim) then print(label, "(PASS)") else error(label, "(FAIL)")$

/* (1) delta f = phi' W delta y + (g - Gamma' phi)' delta c, on a log of 5 rows, 2 drift columns
   and 2 channel regressors, with every entry a symbol */
Dm : genmatrix(lambda([i, j], dd[i, j]), 5, 2)$
Gm : genmatrix(lambda([i, j], gg[i, j]), 5, 2)$
Wm : invert(transpose(Dm) . Dm) . transpose(Dm)$
yv : genmatrix(lambda([i, j], yy[i]), 5, 1)$
cv : matrix([c1], [c2])$
phiv : matrix([f1], [f2])$
gv : matrix([g1], [g2])$
field(y, c) := (transpose(phiv) . Wm . (y - Gm . c)) + (transpose(gv) . c)$
dy : genmatrix(lambda([i, j], ey[i]), 5, 1)$
dc : matrix([ec1], [ec2])$
vanishes("(1) f(y + dy, c + dc) - f(y, c) - phi' W dy - (g - Gamma' phi)' dc",
         ratsimp(field(yv + dy, cv + dc) - field(yv, cv) - (transpose(phiv) . Wm . dy)
                 - (transpose(gv - transpose(Wm . Gm) . phiv) . dc)))$

/* (2) the leverage identity with a 3-column drift design (intercept, state, push) */
A : matrix([a11, a12, a13], [a12, a22, a23], [a13, a23, a33])$
v : matrix([v1], [v2], [v3])$
XtX : matrix([a11, a12, a13, v1], [a12, a22, a23, v2], [a13, a23, a33, v3], [v1, v2, v3, s])$
phi0 : matrix([p1], [p2], [p3])$
h : matrix([p1], [p2], [p3], [u0])$
Ai : invert(A)$
vanishes("(2) h'(X'X)^-1 h - phi'A^-1 phi - (u0 - phi'A^-1 v)^2/(s - v'A^-1 v)",
         ratsimp((transpose(h) . invert(XtX) . h) - (transpose(phi0) . Ai . phi0)
                 - (u0 - (transpose(phi0) . Ai . v))^2/(s - (transpose(v) . Ai . v))))$
/* two channel columns, g = u [1, x], drift [1, x, z], on 7 rows of rational data */
xs : [3/10, -1/2, 6/5, 0, -9/10, 7/10, 2/5]$
zs : [1, -3/2, 1/2, 2, -1, 0, -1/2]$
us : [1/2, -1/3, 5/4, -3/5, 2/3, -1/7, 1/5]$
D7 : genmatrix(lambda([i, j], [1, xs[i], zs[i]][j]), 7, 3)$
G7 : genmatrix(lambda([i, j], [us[i], us[i]*xs[i]][j]), 7, 2)$
X7 : addcol(D7, G7)$
x0 : 2$ ua : 3/2$
h7 : matrix([1, x0, 0, ua, ua*x0])$
ph7 : matrix([1, x0, 0])$
A7 : transpose(D7) . D7$
Gam7 : invert(A7) . transpose(D7) . G7$
M7 : ident(7) - D7 . invert(A7) . transpose(D7)$
lift7 : matrix([ua, ua*x0]) - ph7 . Gam7$
vanishes("(2) two channel columns: h'(X'X)^-1 h - phi'A^-1 phi - L'(G'MG)^-1 L",
         ratsimp((h7 . invert(transpose(X7) . X7) . transpose(h7)) - (ph7 . invert(A7) . transpose(ph7))
                 - (lift7 . invert(transpose(G7) . M7 . G7) . transpose(lift7))))$

/* (3) Frisch-Waugh: the nuisances partial out [1, x, z, x^2], the drift's design [1, x, z] in it;
   the channel's weight on the rows is M = u_res' / (u_res' u_res) */
N7 : addcol(D7, genmatrix(lambda([i, j], xs[i]^2), 7, 1))$
ures : (ident(7) - N7 . invert(transpose(N7) . N7) . transpose(N7)) . transpose(matrix(us))$
Mrow : transpose(ures)/(transpose(ures) . ures)$
vanishes("(3) W M' (the drift's and the channel's errors' covariance, sigma^2 = 1)",
         ratsimp(invert(A7) . transpose(D7) . transpose(Mrow)))$

/* (4) one lever, the channel's coefficient variance C: the exact largest over u_bar +- w is
   C (w + d)^2, at the end away from the projected action; the quadrature C (w^2 + d^2) */
ratio : (w + d)^2/(w^2 + d^2)$
vanishes("(4) d ratio / dw at w = d", ratsimp(subst(w = d, diff(ratio, w))))$
vanishes("(4) ratio at w = d, less 2", ratsimp(subst(w = d, ratio) - 2))$
vanishes("(4) 2 (w^2 + d^2) - (w + d)^2 - (w - d)^2, so the ratio is at most 2",
         ratsimp(2*(w^2 + d^2) - (w + d)^2 - (w - d)^2))$
far : float(sqrt(subst([w = 2, d = 0.62], ratio)))$
print("(4) at w = 2, d = 0.62, the exact standard error over the quadrature's:", far)$
holds("(4) 1.2505 < that < 1.2515", 1.2505 < far and far < 1.2515)$
vanishes("(4) (w^2 + d^2) - (w - d)^2 - 2 w d: toward the projected action the quadrature reads more",
         ratsimp((w^2 + d^2) - (w - d)^2 - 2*w*d))$

/* (5) a convex quadratic's largest over a box is at a vertex: q(u) = u'Pu + 2 p'u + k on
   [-1, 2] x [0, 3], P positive definite; along each lever q is a parabola of curvature 2 P_jj >= 0 */
P : matrix([2, 1], [1, 3])$ pv : matrix([-1], [2])$ k : 1/2$
q(a, b) := (matrix([a, b]) . P . matrix([a], [b])) + 2*(matrix([a, b]) . pv) + k$
holds("(5) P positive definite", P[1, 1] > 0 and determinant(P) > 0)$
vertices : [q(-1, 0), q(-1, 3), q(2, 0), q(2, 3)]$
grid : flatten(makelist(makelist(q(-1 + 3*i/20, 3*j/20), j, 0, 20), i, 0, 20))$
holds("(5) the largest over a 21 x 21 grid of the box is the vertices' largest",
      lmax(grid) = lmax(vertices))$
print("(5) vertices", vertices, "; the grid's largest", lmax(grid))$
