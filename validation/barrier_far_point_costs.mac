/* The far point of a held barrier's safeguarded rounds: the task costs of the plans ADR 0169
   compares, recomputed in 40 digits from the fitted field and the plans' actions.

   Setting (tests/test_channel_sensitivity.py, log 2 of the unstable drift; ADR 0156's far point).
   The fit's field is r(x, u) = d1 + d2 x + c u, the known part zero; a plan is 30 steps of
   dt = 0.1 (the double), rolled out by RK4, and costs
       sum_k [ (x_k - 2)^2 / 2 + 1e-4 u_k^2 / 2 ] + (x_30 - 2)^2 / 2.
   Two start states, -3e-12 (a) and -2e-9 (b), each have two plans certified on all 30 steps:
   the rounds' plan before ADR 0169 ("before"), the projection onto the held columns from the
   iterate after two rounds at the penalty's ceiling, and the projection first at the join
   ("first"), from the first rounds' last iterate. SLSQP's plan on the same held columns, from
   zero, is the reference.

     STEP 1  each plan's cost in 40 digits agrees with the double the library reads, to 1e-14.
     STEP 2  the projection first costs more than the plan before from both start states, and
             both cost more than SLSQP's plan: how far above it, in percent.
     STEP 3  the actions' absolute sums: SLSQP's plan spends least, the projection first most.
*/
display2d : false$
fpprec : 40$

/* ===== the data: the field, the actions, the costs the library read (doubles) ===== */
drift : [0.0462071103420076, 0.6667903228264375]$
chan : 0.27192843207845546$
x0_a_before : -3e-12$
u_a_before : [
  0.1879195930666901, 0.1434465315304728, 0.09794490792644085, 0.050181691016415356,
  -1.600451329610739e-06, 6.298059493209544e-06, -0.0008777457032351419, -2.950076292360557e-06,
  -0.004327050564578492, 1.4900680354207745e-07, -3.690332519209247e-06, -2.3866101164277857e-05,
  1.87588749464082e-07, 2.034691253271099e-07, 2.2093789530550256e-07, 2.408345926654437e-07,
  2.630855327829186e-07, 2.886332398148955e-07, -0.006667308477832896, 3.5240215779395225e-07,
  3.930324875129785e-07, 4.421488286770068e-07, 5.0294652031074e-07, -6.424623827035121e-06,
  -1.5650097887982063e-05, 8.198143261871179e-07, -3.332314381371994e-07, -0.002403572159920612,
  -3.237188582275423e-05, -0.00010820160159692933]$
j_a_before : 51.05506476528103$
x0_a_first : -3e-12$
u_a_first : [
  0.17687050490307873, 0.13114105501955603, 0.08418350189245377, 0.03472466402535817,
  -9.016966203725193e-05, 1.5303847969383972e-05, -0.0008164016420596354, -0.002401881523609745,
  -0.09959807055859767, 0.00019472114407221615, -0.00038238647504708654, 3.231326475276135e-05,
  -0.0003781874495335116, 0.00011934233361730853, -0.005377038626638545, -0.0015991065238469087,
  -0.0003113107940542343, 0.0011888478728890684, 7.298404497654907e-05, 1.3505342357016038e-05,
  -0.0030728270943784506, -0.0005768973075404111, -0.0027002284686312595, -0.0011587767678835187,
  -0.012832144181530827, 0.0005533991927914739, 0.002194196441963571, 0.0028253296401726034,
  -0.025867545911721086, -0.0019175890429687298]$
j_a_first : 51.50122042074011$
x0_b_before : -2e-09$
u_b_before : [
  0.15651262163253282, 0.12925251627901874, 0.09878875232371996, 0.06473643903920717,
  0.026789871366239643, 0.016062307368168348, -0.003463219219112501, 9.533084953420226e-05,
  -7.05283177678432e-06, -1.9093318284313038e-05, -8.197069878460148e-06, -8.854696056646081e-06,
  -0.00028070953716773225, 3.7407698364836313e-05, -2.8354519936009638e-05,
