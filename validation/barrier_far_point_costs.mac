  -4.187477094114697e-05, -0.0001315492891814177, -6.94188472057183e-05, -0.00043831593157206395,
  0.002647982268320496]$
j_b_before : 51.061964547693805$
x0_b_first : -2e-09$
u_b_first : [
  0.149874459892324, 0.12165772722737694, 0.09005785829022667, 0.05465110739240285,
  0.01508380061641076, 0.002409815162296184, 0.0008163400213299347, -0.003945803353836646,
  -0.05364659416598073, -0.0021636813954767245, 0.0007962534360659936, -0.0028260214800808455,
