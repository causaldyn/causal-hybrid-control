j_b_first : 51.44797596253845$
x0_slsqp : 0.0$
u_slsqp : [
  0.4527316709366941, 2.4954661314901162e-11, 5.1050862786178605e-12, 3.3528294803242565e-11,
  2.2803980692920843e-09, 3.5913276533291997e-10, 1.3508836716807482e-11, 1.576563197747027e-11,
  1.5573523241124593e-10, -6.918341984942527e-12, 6.251721477674881e-11, 8.897387587972869e-12,
  3.838178271190233e-13, 5.64455325345788e-11, 8.01311977947023e-11, -3.610342557095927e-12,
  8.147016060283358e-11, 2.8320611463066502e-11, 7.985869530312651e-11, 1.1072059489746219e-11,
  4.49070026122762e-11, -7.05940412542015e-11, -6.784451397016188e-11, 1.5016907360973513e-10,
  6.24325718722952e-11, 2.7129352859853315e-11, 1.041682547691719e-10, -7.390861899476924e-11,
  -1.4618945679358626e-10, -3.26933630128171e-11]$
j_slsqp : 50.995133445939885$

dt : bfloat(0.1d0)$
f(x, u) := bfloat(drift[1]) + bfloat(drift[2]) * x + bfloat(chan) * u$
rk4(x, u) := block([k1, k2, k3, k4],
  k1 : f(x, u), k2 : f(x + dt / 2 * k1, u), k3 : f(x + dt / 2 * k2, u), k4 : f(x + dt * k3, u),
  x + dt / 6 * (k1 + 2 * k2 + 2 * k3 + k4))$
cost(x0, us) := block([x : bfloat(x0), j : 0b0, u],
  for k thru length(us) do (
    u : bfloat(us[k]),
    j : j + (x - 2) ^ 2 / 2 + bfloat(1d-4) * u ^ 2 / 2,
    x : rk4(x, u)),
  j + (x - 2) ^ 2 / 2)$

/* ===== STEP 1: the costs in 40 digits ===== */
print("=== STEP 1: each plan's cost in 40 digits against the library's double ===")$
plans : [["a_before", x0_a_before, u_a_before, j_a_before],
         ["a_first", x0_a_first, u_a_first, j_a_first],
         ["b_before", x0_b_before, u_b_before, j_b_before],
         ["b_first", x0_b_first, u_b_first, j_b_first],
         ["slsqp", x0_slsqp, u_slsqp, j_slsqp]]$
exact : makelist(cost(p[2], p[3]), p, plans)$
for i thru length(plans) do block([gap : abs(bfloat(plans[i][4]) - exact[i]) / exact[i]],
  print("STEP 1", plans[i][1], "40 digits:", exact[i], "library:", plans[i][4],
        "relative gap:", float(gap), if gap < 1b-14 then "(PASS)" else "(FAIL)"))$
[ja, jfa, jb, jfb, js] : exact$

/* ===== STEP 2: over SLSQP's cost ===== */
print("=== STEP 2: the projection first costs more; percent above SLSQP's plan ===")$
over(j) := float(100 * (j / js - 1))$
print("STEP 2 a: before", over(ja), "%, first", over(jfa), "%; b: before", over(jb),
      "%, first", over(jfb), "%")$
print("STEP 2", if js < ja and ja < jfa and js < jb and jb < jfb then "(PASS)" else "(FAIL)")$

/* ===== STEP 3: what each plan spends ===== */
print("=== STEP 3: the actions' absolute sums ===")$
spent(us) := float(lsum(abs(u), u, us))$
print("STEP 3 a: SLSQP", spent(u_slsqp), "before", spent(u_a_before), "first", spent(u_a_first))$
print("STEP 3", if spent(u_slsqp) < spent(u_a_before) and spent(u_a_before) < spent(u_a_first)
      then "(PASS)" else "(FAIL)")$
