/* Maxima is the AUTHORITATIVE reference for how far chc.irf.delay_estimate's peak can sit from the
   delay, and so for the half step its interval adds on each side.

   A transport lag of c = m + f sample steps (m whole, 0 <= f < 1), seen through an input held over
   each step and an outcome read as its change over each step, puts its response on the grid as
   the hat 1 - |h - c|: weight 1 - f at step m and f at step m + 1.  The peak's location is a
   statistic of those samples, and a bootstrap of it carries its spread, not its distance from c.
   This file computes that distance for the integer peak and for the parabola of peak_lag, the
   centroid that removes it on the hat, and that centroid's cost on a one-sided response.  Every
   distance is in steps. */

display2d : false$
/* a check that fails stops the batch with "-- an error.", which validation/run_all.sh reads */
vanishes(label, x) := if is(ratsimp(x) = 0) then print(label, "= 0")
  else error(label, "is not zero:", x)$
holds(label, ok) := if ok then print(label, "holds") else error(label, "does not hold")$

/* (1) the sampled response: the overlap of the held pulse [c, c + 1) with each step [h, h + 1) */
assume(f >= 0, f < 1)$
beta_m : integrate(1, s, m + f, m + 1)$
beta_m1 : integrate(1, s, m + 1, m + 1 + f)$
vanishes("(1) step m reads 1 - f:", beta_m - (1 - f))$
vanishes("(1) step m + 1 reads f:", beta_m1 - f)$
vanishes("(1) the hat at step m:", beta_m - (1 - abs(m - (m + f))))$
vanishes("(1) the hat at step m + 1:", beta_m1 - (1 - abs(m + 1 - (m + f))))$

/* (1b) DelayOscillationTask's own log, counted: 30 plant steps a sample, a lag of 100 of them.
   The change over sample k collects the held input of the plant steps t in [30 k, 30 k + 30),
   delayed by 100: a sub-step reads the sample floor((t - 100)/30).  Shares of samples k - 3, k - 4: */
share(k, j) := sum(if floor((t - 100)/30) = j then 1 else 0, t, 30*k, 30*k + 29)/30$
holds("(1b) the change over sample 10 is 2/3 of sample 7 and 1/3 of sample 6",
      is(share(10, 7) = 2/3) and is(share(10, 6) = 1/3) and is(share(10, 5) = 0)
      and is(share(10, 8) = 0))$
print("(1b) so tau = 1, a step of 0.3, is c = 10/3: m = 3, f = 1/3")$

/* (2) the integer peak is the nearest step: c - argmax is f below a half and f - 1 above it */
gap_int(f) := if f < 1/2 then f else f - 1$
holds("(2) |c - argmax| <= 1/2 on a grid of f, and reaches 1/2 at the tie",
      every(lambda([q], is(abs(gap_int(q)) <= 1/2)), makelist(i/240, i, 0, 239))
      and is(abs(gap_int(1/2)) = 1/2))$
print("(2) c - argmax at tau = 1 (f = 1/3):", gap_int(1/3), "; at tau = 2 (f = 2/3):", gap_int(2/3),
      "-- the peak 0.1 below the delay, then 0.1 above it, at a step of 0.3")$

/* (3) the parabola's vertex: delay_estimate_bias.mac gives m + f/(4 - 6 f) for f <= 1/2 */
vertex(l, c0, r) := block([p : (r + l)/2 - c0, q : (r - l)/2], -q/(2*p))$
vanishes("(3) vertex(0, 1 - f, f) = f/(4 - 6 f):", vertex(0, 1 - f, f) - f/(4 - 6*f))$
gap_vertex : f - f/(4 - 6*f)$
vanishes("(3) c - vertex = 3 f (1 - 2 f)/(4 - 6 f):", gap_vertex - 3*f*(1 - 2*f)/(4 - 6*f))$
crit : solve(diff(gap_vertex, f) = 0, f)$
print("(3) stationary points of c - vertex:", crit)$
vanishes("(3) the largest gap, at f = 1/3, is 1/6:", subst(f = 1/3, gap_vertex) - 1/6)$
holds("(3) it is the largest on [0, 1/2]",
      every(lambda([q], is(subst(f = q, gap_vertex) <= 1/6)), makelist(i/240, i, 0, 120)))$
/* above a half the peak is step m + 1, and the vertex sits as far above c as it sat below */
vanishes("(3) f = 2/3: the vertex is 1/6 above c:",
         (1 + vertex(1/3, 2/3, 0)) - 2/3 - 1/6)$

/* (4) the centroid of the three samples around the peak recovers c on the hat, both sides */
centroid(l, c0, r) := (r - l)/(l + c0 + r)$
vanishes("(4) centroid on the hat, f <= 1/2:", centroid(0, 1 - f, f) - f)$
vanishes("(4) centroid on the hat, f > 1/2 (peak at m + 1):", 1 + centroid(1 - f, f, 0) - f)$
vanishes("(4) the hat's mass is 1:", beta_m + beta_m1 - 1)$
vanishes("(4) the hat's mean is c:", m*beta_m + (m + 1)*beta_m1 - (m + f))$

/* (5) the same samples, read as a discrete plant y_t = (1 - f) u_{t-m} + f u_{t-m-1}, have their
   largest effect at m for f < 1/2: the samples cannot tell a lag of m from one of m + f, so no
   interval narrower than the half step is sound without the hat's premise.  On a one-sided
   response (0, 1, phi), a delay of exactly m, the centroid is late by phi/(1 + phi): */
vanishes("(5) centroid of (0, 1, phi):", centroid(0, 1, phi) - phi/(1 + phi))$
vanishes("(5) centroid - vertex = 3 phi (1 - phi)/(2 (1 + phi) (2 - phi)):",
         phi/(1 + phi) - phi/(2*(2 - phi)) - 3*phi*(1 - phi)/(2*(1 + phi)*(2 - phi)))$
print("(5) every factor is positive on 0 < phi < 1: the centroid is the later of the two")$
print("(5) phi = 1/2: centroid", 1/3, ", vertex", 1/6, ", integer peak 0 steps late")$
