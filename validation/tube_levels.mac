/* The tube's levels: a joint band over the horizon and a region for the channel.

   Checked here:
   (1) the conformal rank: for n = 1..12 calibration scores and delta = 1/20, 2/20, ..., 10/20,
       k = ceil((n + 1)(1 - delta)), wherever k <= n, gives the coverage k/(n + 1), which lies in
       [1 - delta, 1 - delta + 1/(n + 1));
   (2) the mean Kullback-Leibler divergence from a Gaussian VAR(1)'s k-step law to its stationary
       one, x ~ N(0, S): E KL = -log det(I - S^-1 F S F') / 2, F the k-step matrix, on a symbolic
       2x2 F and S; on one state of correlation rho it is -log(1 - rho^(2k)) / 2;
   (3) the bound beta(k) <= sqrt(E KL / 2) against the exact mean total variation of one state at
       rho = 0.8, k = 1 and 3, by a double integral;
   (4) the per-step tube's joint coverage over two steps on AR(1) noise, each step at its own
       0.95 radius, by a one-dimensional integral: below 0.95;
   (5) the channel region's stability level: A = (-a1 + sqrt(a1^2 - a2 a0)) / a2 solves
       sum_s (R_s A + b_s)^2 = T^2, and delta = n exp((L - A^2) / 2) inverts
       A^2 = 2 log(n / delta) + L. */
display2d : false$
fpprec : 40$
/* a check that fails stops the batch with "-- an error.", which validation/run_all.sh reads */
vanishes(label, x) := if (if matrixp(x) then every(lambda([e], is(e = 0)), flatten(args(x)))
                          else is(x = 0))
  then print(label, "= 0") else error(label, "is not zero:", x)$
near(label, x, y, tol) := if is(abs(x - y) <= tol) then print(label, x, "~", y)
  else error(label, x, "is not within", tol, "of", y)$
holds(label, p) := if is(p) then print(label, "holds") else error(label, "fails")$

/* (1) the conformal rank's coverage, exact rationals */
for n : 1 thru 12 do
  for i : 1 thru 10 do block([delta : i/20, k],
    k : ceiling((n + 1)*(1 - delta)),
    if k <= n then (
      holds(sconcat("(1) n=", n, " delta=", delta, " lower"), k/(n + 1) >= 1 - delta),
      holds(sconcat("(1) n=", n, " delta=", delta, " upper"), k/(n + 1) < 1 - delta + 1/(n + 1))))$

/* (2) the mean KL, symbolic 2x2: KL(N(m, Sc) || N(0, S)) = (tr(S^-1 Sc) + m'S^-1 m - n
   - log det(S^-1 Sc)) / 2, Sc = S - F S F', and E[m'S^-1 m] = tr(S^-1 F S F') for m = F x */
F : matrix([f11, f12], [f21, f22])$
S : matrix([s11, s12], [s12, s22])$
Si : invert(S)$
Sc : S - F . S . transpose(F)$
traces : ratsimp(mat_trace(Si . Sc) + mat_trace(Si . F . S . transpose(F)) - 2)$
vanishes("(2) the traces cancel", traces)$
/* what is left is -log det(S^-1 Sc) / 2 = -log det(I - S^-1 F S F') / 2 */
vanishes("(2) det(S^-1 Sc) = det(I - S^-1 F S F')",
  ratsimp(determinant(Si . Sc) - determinant(ident(2) - Si . F . S . transpose(F))))$
/* one state, stationary variance 1: m = rho^k x, v = 1 - rho^(2k), E x^2 = 1 */
kl1 : (v + m2 - 1 - log(v))/2$
vanishes("(2) one state",
  ratsimp(subst([v = 1 - rho^(2*k), m2 = rho^(2*k)], kl1) - (-log(1 - rho^(2*k))/2)))$

/* (3) the exact mean total variation at rho = 0.8, against the bound sqrt(-log(1 - rho^2k)) / 2 */
gauss(x, mu, var) := exp(-(x - mu)^2/(2*var))/sqrt(2*%pi*var)$
tv_at(x0, rho, k) := if not numberp(x0) then 'tv_at(x0, rho, k) else
  block([mu : rho^k*x0, var : 1 - rho^(2*k)],
  quad_qags(abs(gauss(y, mu, var) - gauss(y, 0, 1)), y, -12, 12, epsrel = 1d-10)[1]/2)$
for k in [1, 3] do block([rho : 0.8, exact, bound],
  exact : quad_qags(gauss(x, 0, 1)*tv_at(x, rho, k), x, -9, 9, epsrel = 1d-8)[1],
  bound : sqrt(-log(1 - rho^(2*k)))/2,
  print("(3) k =", k, "beta exact", exact, "bound", bound),
  holds(sconcat("(3) the bound at k = ", k), exact <= bound))$

/* (4) the per-step tube's joint coverage over two steps: e1 ~ N(0, s1), e2 = M e1 + w,
   w ~ N(0, s), M = R(-0.1) RK4's step of x' = -0.5 x at dt = 0.2, s1 = s, s2 = M^2 s + s, each step's radius z sqrt(s_k), z = 1.959963984540054 */
block([M : 1 - 0.1 + 0.1^2/2 - 0.1^3/6 + 0.1^4/24, s : 0.0025, z : 1.959963984540054, s1, s2, joint],
  s1 : s, s2 : M^2*s + s,
  joint : quad_qags(gauss(e, 0, s1)*(
      (1 + erf((z*sqrt(s2) - M*e)/sqrt(2*s)))/2 - (1 + erf((-z*sqrt(s2) - M*e)/sqrt(2*s)))/2),
    e, -z*sqrt(s1), z*sqrt(s1), epsrel = 1d-12)[1],
  print("(4) the joint coverage of two 0.95 steps:", joint),
  holds("(4) below 0.95", joint < 0.95),
  near("(4) the value the tests read", joint, 0.9152476, 1d-7))$

/* (5) the stability level's two inversions */
a2 : r1^2 + r2^2$ a1 : r1*b1 + r2*b2$ a0 : b1^2 + b2^2 - T^2$
A : (-a1 + sqrt(a1^2 - a2*a0))/a2$
vanishes("(5) A solves the sum of squares",
  ratsimp(radcan(expand((r1*A + b1)^2 + (r2*A + b2)^2 - T^2))))$
delta : n*exp((L - A2)/2)$
vanishes("(5) delta inverts A^2", radcan(2*log(n/delta) + L - A2))$
