/* The discount DLM over geos behind chc.geo_dlm: the identities its docstring states.

   STEP 1  two geos observed at one step, sharing the unknown variance: the joint update (West and
           Harrison 1997, section 16.4) gives the mean, covariance, degrees of freedom and variance
           estimate that updating on one geo and then on the other gives
   STEP 2  the joint one-step density, a bivariate Student t with n degrees of freedom, is the
           product of the first geo's t with n and the second's given it, with n + 1
   STEP 3  each geo's row reads the national block and its own: the posterior precision gains
           nothing between two geos, and the multiplicative form, a diagonal scaling of the
           covariance, keeps that zero; component discounting does not

   Run: timeout 600 maxima -X "--dynamic-space-size 8192" --very-quiet -b validation/geo_dlm.mac */

linel : 110$
display2d : false$
scalarmatrixp : false$  /* a 1 x 1 product stays a matrix, so [1, 1] reads its entry */

print("=== STEP 1: the joint update is the sequential one ===")$
/* a two-coordinate prior (a, R) stated at S, two observations with relative variances w1, w2 */
a : matrix([a1], [a2])$
R : matrix([r11, r12], [r12, r22])$
F : matrix([f11, f12], [f21, f22])$   /* row g is geo g's design */
W : matrix([w1, 0], [0, w2])$
y : matrix([y1], [y2])$

Q : F . R . transpose(F) + S*W$
e : y - F . a$
A : R . transpose(F) . invert(Q)$
q : (transpose(e) . invert(Q) . e)[1, 1]$
n2 : n + 2$
S2 : S*(n + q)/n2$
m2 : a + A . e$
C2 : (S2/S)*(R - A . Q . transpose(A))$

/* one geo at a time: geo 1, then geo 2 with no evolution between */
observe(a0, R0, S0, n0, f, yy, w) := block([q0, e0, A0, n1, S1],
  q0 : (f . R0 . transpose(f))[1, 1] + S0*w,
  e0 : yy - (f . a0)[1, 1],
  A0 : R0 . transpose(f) / q0,
  n1 : n0 + 1,
  S1 : S0*(n0 + e0^2/q0)/n1,
  [a0 + A0*e0, (S1/S0)*(R0 - A0 . transpose(A0)*q0), S1, n1, e0, q0])$
after1 : observe(a, R, S, n, row(F, 1), y1, w1)$
after2 : observe(after1[1], after1[2], after1[3], after1[4], row(F, 2), y2, w2)$

zero(x) := is(ratdisrep(ratsimp(rat(x))) = 0)$
/* run_all.sh reads only whether a file completed, so an identity that fails stops it */
require(label, holds) := if holds then print(label, true) else error(label, "does not hold")$
require("mean, joint = sequential:",
        zero(m2[1, 1] - after2[1][1, 1]) and zero(m2[2, 1] - after2[1][2, 1]))$
require("covariance, joint = sequential:", zero(C2[1, 1] - after2[2][1, 1])
        and zero(C2[1, 2] - after2[2][1, 2]) and zero(C2[2, 2] - after2[2][2, 2]))$
require("variance estimate, joint = sequential:", zero(S2 - after2[3]))$
require("degrees of freedom, joint = sequential:", is(n2 - after2[4] = 0))$

print("=== STEP 2: the bivariate t is the product of the sequential t's ===")$
/* log t_nu(e; q) without its normalising Gamma terms, which cancel: with r = 2,
   lgamma((n+2)/2) - lgamma(n/2) on the left is lgamma((n+1)/2) - lgamma(n/2) +
   lgamma((n+2)/2) - lgamma((n+1)/2) on the right */
joint_log : -log(n*%pi) - log(determinant(Q))/2 - (n + 2)/2*log(1 + q/n)$
sequential_log : -log(n*%pi*after1[6])/2 - (n + 1)/2*log(1 + after1[5]^2/(n*after1[6]))
                 - log((n + 1)*%pi*after2[6])/2 - (n + 2)/2*log(1 + after2[5]^2/((n + 1)*after2[6]))$
/* with f1 = 1 + e1^2 / (n q1) and f2 = 1 + e2^2 / ((n+1) q2), the second geo's error and squared
   scale read after the first's update, two identities close it:
   1 + q / n = f1 f2, and n q1 (n+1) q2 = n^2 det(Q) f1 */
require("1 + q/n = product of the sequential factors:",
        zero((1 + q/n) - (1 + after1[5]^2/(n*after1[6]))*(1 + after2[5]^2/((n + 1)*after2[6]))))$
require("n^2 det(Q) (1 + e1^2/(n q1)) = n q1 (n+1) q2:",
        zero(n^2*determinant(Q)*(1 + after1[5]^2/(n*after1[6])) - n*after1[6]*(n + 1)*after2[6]))$
/* so joint_log - sequential_log = -log(n) - log(det(Q))/2 - log(f1)/2 + log(n q1 (n+1) q2)/2,
   which the second identity makes 0 */

print("=== STEP 3: the precision's zero between two geos ===")$
/* state (national, geo 1, geo 2) with an arrowhead precision */
Lambda : matrix([l00, l01, l02], [l01, l11, 0], [l02, 0, l22])$
C : invert(Lambda)$
/* multiplicative: R = D C D with D diagonal */
D : matrix([d0, 0, 0], [0, d1, 0], [0, 0, d2])$
Rm : D . C . D$
require("multiplicative: (R^-1)[2, 3] is zero:", zero(invert(Rm)[2, 3]))$
/* additive component discounting: R = C + diag(k_i C_ii) */
Ra : C + matrix([k0*C[1, 1], 0, 0], [0, k1*C[2, 2], 0], [0, 0, k2*C[3, 3]])$
geos12 : ratdisrep(ratsimp(rat(invert(Ra)[2, 3])))$
require("additive: (R^-1)[2, 3] is not zero:", not is(geos12 = 0))$
print("additive, one discount for every block: (R^-1)[2, 3] at k0 = k1 = k2 = k, l01 = l02 = 1:",
      factor(ratsimp(subst([k0 = k, k1 = k, k2 = k, l01 = 1, l02 = 1], geos12))))$
/* and the observation update adds f f' / (S w) with f nonzero on the national block and one geo's */
f1 : matrix([g0, g1, 0])$
require("an observation of geo 1 adds nothing to (Lambda)[2, 3]:", is((transpose(f1) . f1)[2, 3] = 0))$
