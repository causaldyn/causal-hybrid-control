/* Symbolic cross-check of the scalar continuous ARE in Maxima.
   Scalar system a=-1/10, b=1, q=1, r=1:  2 a p - (b^2/r) p^2 + q = 0.
   The stabilizing (positive) root must match scipy's solve_continuous_are. */

a : -1/10$
b : 1$
q : 1$
r : 1$

eq : 2*a*p - (b^2/r)*p^2 + q = 0$
sols : solve(eq, p)$
print("symbolic roots p =", sols)$
print("numeric roots p =", float(map(rhs, sols)))$

/* closed-form stabilizing root */
pstab : (a + sqrt(a^2 + b^2*q/r)) * r / b^2$
print("stabilizing P (scalar) =", float(pstab))$
print("gain K = (b/r) P =", float((b/r)*pstab))$
