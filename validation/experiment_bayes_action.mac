/* The expected cost of chc.experiment's decision under a Gaussian channel, and so its Bayes action.

   x = x0 + C diag(b) u, J(u; b) = (x - x*)' Q (x - x*) / 2 + u' R u / 2, b ~ N(m, S). J is
   quadratic in b, so its expectation needs only E[b] = m and E[b b'] = m m' + S:

   STEP 1  E J(u; b) = J(u; m) + u' ((C' Q C) o S) u / 2, o the elementwise product, here for two
           zones with every entry a symbol; the Bayes action is the certainty-equivalent one with
           R raised by (C' Q C) o S, positive semidefinite by Schur's product theorem.

   Run: timeout 120 maxima --very-quiet -Q -b validation/experiment_bayes_action.mac */

display2d : false$

C : matrix([c11, c12], [c21, c22])$
Q : matrix([q11, q12], [q12, q22])$
R : matrix([r11, r12], [r12, r22])$
u : matrix([u1], [u2])$
d : matrix([d1], [d2])$  /* x0 - x* */
J(b1, b2) := block([x], x : d + C . matrix([b1 * u1], [b2 * u2]),
  (transpose(x) . Q . x + transpose(u) . R . u) / 2)$

/* the expectation of a polynomial of degree at most 2 in b1, b2 */
expected(p) := block([q],
  q : ratsubst(B11, b1^2, p), q : ratsubst(B22, b2^2, q), q : ratsubst(B12, b1 * b2, q),
  q : subst([B11 = m1^2 + s11, B22 = m2^2 + s22, B12 = m1 * m2 + s12], q),
  expand(subst([b1 = m1, b2 = m2], q)))$

H : transpose(C) . Q . C$
step1 : ratsimp(expected(expand(J(b1, b2)))
                - (J(m1, m2) + (transpose(u) . matrix([H[1, 1] * s11, H[1, 2] * s12],
                                                      [H[2, 1] * s12, H[2, 2] * s22]) . u) / 2))$
print("STEP 1 E J less J(u; m) + u'((C'QC) o S) u / 2 (expect 0):", step1)$

/* STEP 2  The regret now at a knife edge, one zone, x = b u - e, J = q x^2 / 2 + r u^2 / 2, where
           the prior mean m = sqrt(r / q) makes u*(b) = q e b / (q b^2 + r) stationary: to
           fourth order in the prior sd s the certainty-equivalent action loses
           3 e^2 q^3 s^4 / (16 r^2), and the Bayes action q e m / (q (m^2 + s^2) + r) two thirds
           of it, e^2 q^3 s^4 / (8 r^2). The regret of u at b is (q b^2 + r) (u - u*(b))^2 / 2,
           exactly; b = m + s z, z standard normal, and E z^(2k) = (2k)! / (2^k k!). */

kill(m, z)$
assume(q > 0, r > 0, e > 0, s > 0)$
edge : sqrt(r / q)$
ustar(b) := q * e * b / (q * b^2 + r)$
regret(u, b) := (q * b^2 + r) / 2 * (u - ustar(b))^2$
gauss(p) := block([t : expand(p)], sum(coeff(t, z, 2 * k) * (2 * k)! / (2^k * k!), k, 0, 4))$
fourth(u) := ratsimp(gauss(expand(ratsimp(taylor(regret(u, edge + s * z), s, 0, 4)))))$
ce : fourth(ustar(edge))$
bayes : fourth(q * e * edge / (q * (edge^2 + s^2) + r))$
print("STEP 2 CE regret less 3 e^2 q^3 s^4 / (16 r^2) (expect 0):",
      ratsimp(ce - 3 * e^2 * q^3 * s^4 / (16 * r^2)))$
print("STEP 2 Bayes regret less e^2 q^3 s^4 / (8 r^2) (expect 0):",
      ratsimp(bayes - e^2 * q^3 * s^4 / (8 * r^2)))$

/* and the series against the exact expectation, by quadrature at q = 1, r = 1/2, e = 1, s = 1/20:
   the relative gap is of order 10 q s^2 / r = 0.05 */
point : [q = 1, r = 1/2, e = 1, s = 1/20]$
integrand : subst(point, regret(q * e * edge / (q * (edge^2 + s^2) + r), edge + s * z))
            * exp(-z^2 / 2) / sqrt(2 * %pi)$
bayes_exact : first(quad_qagi(integrand, z, minf, inf))$
gap : float(bayes_exact / subst(point, e^2 * q^3 * s^4 / (8 * r^2)) - 1)$
print("STEP 2 exact over the s^4 law, less 1 (expect |.| < 0.05):", gap)$
