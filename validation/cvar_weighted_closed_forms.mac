/* The weighted worst share chc.allocation.cvar_allocate maximises under `weights=`, and the closed
   forms tests/test_cvar_allocation.py reads on two linear readings.

   Readings weighed w_i, summing to W, have the worst `level` share's mean
       R(g) = max_eta eta - sum_i (w_i / W) (eta - g_i)_+ / level
   (Rockafellar and Uryasev 2000, Journal of Risk). The code reads it as a weighted quantile: the
   readings in order of gain, worst first, each taking its whole weight until the share is full, the
   reading at the boundary the rest of it, the mean their weighted gains over the level.

   STEP 1  the quantile form equals Rockafellar and Uryasev's on rational gains, weights and levels,
           a weight 0 among them
   STEP 2  integer weights 2, 1 and 3 are the readings repeated twice, once and three times
   STEP 3  two linear readings: A returns 3 and 1 a unit on two channels, B 1 and 2, the reference
           the even split of 100, so their gains are 2 d and -d, d the first channel's move. The
           share's mean is piecewise linear in d with its one kink at 0, so its most is at -50, 0 or
           50; the closed forms at three levels under weights (1, 3) and (3, 1)

   Run: timeout 300 maxima --very-quiet -Q -b validation/cvar_weighted_closed_forms.mac */

display2d : false$
ratprint : false$

/* Rockafellar and Uryasev: the most over eta is at one of the gains, a kink */
ru(g, w, L) := block([W : apply("+", w)],
  lmax(makelist(e - apply("+", makelist(w[i] * max(e - g[i], 0), i, 1, length(g))) / W / L,
                e, g)))$

/* the weighted quantile: gains in order, each its whole weight until the share is full */
quantile(g, w, L) := block([W : apply("+", w), order, before : 0, total : 0, m],
  order : sort(makelist([g[i], w[i] / W], i, 1, length(g)), lambda([a, b], a[1] < b[1])),
  for p in order do (
    m : min(p[2], max(L - before, 0)),
    total : total + m * p[1],
    before : before + p[2]),
  total / L)$

/* STEP 1 */
cases : [
  [[3, -1, 7/2, 0], [1, 2, 0, 5], 1/3],
  [[3, -1, 7/2, 0], [1, 2, 0, 5], 1],
  [[-5, 2, 2, 9, -1/7], [3, 1, 4, 1, 5], 2/9],
  [[-5, 2, 2, 9, -1/7], [3, 1, 4, 1, 5], 7/10],
  [[10], [4], 1/5],
  [[1, -2], [1, 1000000], 1/1000]]$
step1 : makelist(ratsimp(quantile(c[1], c[2], c[3]) - ru(c[1], c[2], c[3])), c, cases)$
print("STEP 1  quantile less Rockafellar-Uryasev:", step1,
      if every(lambda([x], x = 0), step1) then "(PASS)" else "(FAIL)")$

/* STEP 2 */
g3 : [7, -3/2, 1/3]$
step2 : makelist(
  ratsimp(ru(g3, [2, 1, 3], L) - ru([7, 7, -3/2, 1/3, 1/3, 1/3], [1, 1, 1, 1, 1, 1], L)),
  L, [1/10, 1/6, 1/3, 9/20, 1/2, 5/6, 1])$
print("STEP 2  weights 2, 1, 3 less the readings repeated:", step2,
      if every(lambda([x], x = 0), step2) then "(PASS)" else "(FAIL)")$

/* STEP 3: [weights, level, first channel's spend, the share's most] as the tests read them */
expected : [
  [[1, 3], 1/2, 50, 0],
  [[1, 3], 4/5, 0, 25/8],
  [[1, 3], 1, 0, 25/2],
  [[3, 1], 1/2, 100, 25],
  [[3, 1], 4/5, 100, 425/8],
  [[3, 1], 1, 100, 125/2]]$
best(w, L) := block([read],
  read : makelist([d, quantile([2 * d, -d], w, L)], d, [-50, 0, 50]),
  read : sort(read, lambda([a, b], a[2] > b[2])),
  /* the most is unique */
  if read[1][2] > read[2][2] then [read[1][1] + 50, read[1][2]] else false)$
step3 : makelist(is(best(e[1], e[2]) = [e[3], e[4]]), e, expected)$
print("STEP 3  the closed forms:", step3, if every(identity, step3) then "(PASS)" else "(FAIL)")$

/* STEP 3b: the pieces in the weights. q_A + q_B = 1; for d > 0 B is worst, for d < 0 A */
piece_up(qB, L, d) := if L <= qB then -d else d * (2 * L - 3 * qB) / L$
piece_down(qA, L, d) := if L <= qA then 2 * d else d * (3 * qA - L) / L$
pieces(qB, L, d) := [
  ratsimp(ru([2 * d, -d], [1 - qB, qB], L) - piece_up(qB, L, d)),
  ratsimp(ru([-2 * d, d], [1 - qB, qB], L) - piece_down(1 - qB, L, -d))]$
step3b : flatten(makelist(makelist(pieces(p[1], p[2], d),
  p, [[1/4, 1/2], [1/4, 4/5], [3/4, 1/2], [3/4, 4/5], [1/3, 1], [2/3, 1/5]]), d, [1, 50, 7/3]))$
print("STEP 3b  the pieces less Rockafellar-Uryasev:", step3b,
      if every(lambda([x], x = 0), step3b) then "(PASS)" else "(FAIL)")$
