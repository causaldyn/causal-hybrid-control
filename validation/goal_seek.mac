/* Closed forms chc.allocation.budget_for is tested against (tests/test_goal_seek.py). A plan's
   gain I(B) is its return over spending nothing, at the best split of the budget B.

   STEP 1  one Michaelis-Menten channel, no carryover, one period, I = b B / (K + B): the least
           budget that gains a, the budget whose last unit returns m, and the most budget whose
           average return is r, which is where I - r B, whose peak is at the marginal budget,
           falls back through zero
   STEP 2  one exponential channel, I = b (1 - exp(-B/K)): the same three; the average return's
           root is K (c + W(-c exp(-c))) with c = b / (r K), on W's principal branch
   STEP 3  a floor makes the average return rise before it falls: a Michaelis-Menten channel
           (b1 = 900, K1 = 50, from 0) beside a linear one returning 1/2 a unit held at its floor
           of 200. At r = 2 the average crosses twice, and the most budget is the second crossing,
           325 + 25 sqrt(13), not the first, 325 - 25 sqrt(13)
   STEP 4  two Hill curves of slope 3, h(z) = z^3 / (1 + z^3), at scales 1 and 1.01: a gain a all
           on the first takes B = (a / (1 - a))^(1/3), (7/3)^(1/3) at 0.7 and 3^(1/3) at 0.75. No
           split of B gains more: the worth's derivative along the split changes sign once
           inside, at the splits' least worth, and the first's end returns more than the second's
   STEP 5  a floor of 1 on h beside a channel returning z / (2 (1 + z)): the chord from the origin
           touches h at 2^(1/3) with a slope of 2^(2/3) / 3, 0.529, under 0.55, and h's own slope
           at the floor is 3/4. It meets 0.55 at 1.2353, to 40 digits; the other channel's slope is
           at most 1/2
   STEP 6  two equal Hill curves of slope 3: the average h(z) / z peaks at 2^(1/3), and is 1/2 at
           1 and past the peak at the golden ratio, so a return of 1/2 a unit is met at 1 + sqrt(5)
           split evenly, which beats every other split of it with caps of 3: the worth's
           derivative along the split changes sign once, from rising to falling, at the even split

   Run: timeout 120 maxima --very-quiet -b validation/goal_seek.mac */

linel : 110$
display2d : false$
fpprintprec : 16$

/* STEP 1 */
I1(B) := b*B/(K + B)$
Ba : a*K/(b - a)$
Bm : sqrt(b*K/m) - K$
Br : b/r - K$
print("STEP 1a  I(Ba) - a:", ratsimp(I1(Ba) - a))$
print("STEP 1b  I'(Bm) - m:", ratsimp(subst(B = Bm, diff(I1(B), B)) - m))$
print("STEP 1c  I(Br) / Br - r:", ratsimp(I1(Br)/Br - r))$
print("STEP 1d  the average falls with B, d(I/B)/dB:", ratsimp(diff(I1(B)/B, B)))$
print("STEP 1e  I - r B peaks at the marginal budget for m = r:",
      ratsimp(subst([B = subst(m = r, Bm)], diff(I1(B) - r*B, B))))$

/* STEP 2 */
I2(B) := b*(1 - exp(-B/K))$
Ea : -K*log(1 - a/b)$
Em : K*log(b/(K*m))$
print("STEP 2a  I(Ea) - a:", ratsimp(I2(Ea) - a))$
print("STEP 2b  I'(Em) - m:", ratsimp(subst(B = Em, diff(I2(B), B)) - m))$
/* x = B/K solves c (1 - exp(-x)) = x; with x = c + w and w exp(w) = -c exp(-c), exp(-x) is
   exp(-c) / exp(w) = -w / c */
c : b/(r*K)$
x : c + w$
print("STEP 2c  c (1 - exp(-x)) - x, exp(-x) = -w/c:", ratsimp(c*(1 - (-w/c)) - x))$
print("STEP 2d  and exp(-x) = -w/c follows from w exp(w) = -c exp(-c):",
      ratsimp(exp(-c)/(-c*exp(-c)/w) - (-w/c)))$

/* STEP 3 */
b1 : 900$ K1 : 50$ slope2 : 1/2$ floor2 : 200$ rr : 2$
/* x is channel 1's spend; channel 2 stays at its floor while channel 1's slope beats 1/2 */
gain(x) := b1*x/(K1 + x) + slope2*floor2$
f3 : ratsimp((gain(xs) - rr*(xs + floor2))*(K1 + xs))$
roots : solve(f3 = 0, xs)$
print("STEP 3a  where the average return is 2:", roots)$
xhi : 125 + 25*sqrt(13)$
xlo : 125 - 25*sqrt(13)$
print("STEP 3b  both are roots:", ratsimp(subst(xs = xhi, f3)), ratsimp(subst(xs = xlo, f3)))$
print("STEP 3c  the budgets:", floor2 + xlo, "=", float(floor2 + xlo), " and", floor2 + xhi, "=",
      float(floor2 + xhi))$
print("STEP 3d  channel 1's slope there beats 1/2, so channel 2 stays at its floor:",
      float(b1*K1/(K1 + xhi)^2))$
print("STEP 3e  the marginal budget at 2 and the gain less 2 B there (positive):",
      floor2 + sqrt(b1*K1/rr) - K1, ",", gain(sqrt(b1*K1/rr) - K1) - rr*(sqrt(b1*K1/rr) - K1 + floor2))$

/* STEP 4 */
h(z) := z^3/(1 + z^3)$
block([x, B, worth, along, inside],
  for a in [7/10, 3/4] do (
    B : (a/(1 - a))^(1/3),
    print("STEP 4a  a =", a, ": B =", B, "=", bfloat(B), ", h(B) - a:", ratsimp(h(B) - a)),
    worth : h(x) + h((bfloat(B) - x)/1.01b0),
    along : diff(worth, x),
    inside : sublist(makelist(bfloat(k*B/4000), k, 1, 3999),
                     lambda([s], is(sign(float(subst(x = s, along))) #
                                    sign(float(subst(x = s + bfloat(B)/4000, along)))))),
    print("STEP 4b  sign changes of the worth's derivative along the split inside:", length(inside)),
    for s in inside do print("  near", float(s), "worth", float(subst(x = s, worth))),
    print("STEP 4c  the ends: all on the first", float(subst(x = bfloat(B), worth)),
          ", all on the second", float(subst(x = 0, worth)))))$

/* STEP 5 */
block([t, z, slope],
  t : 2^(1/3),
  print("STEP 5a  the chord's slope h(t) / t at the tangency 2^(1/3):", ratsimp(h(t)/t), "=",
        float(h(t)/t)),
  slope : diff(h(z), z),
  print("STEP 5b  h's slope at the floor of 1:", subst(z = 1, slope)),
  fpprec : 40,
  print("STEP 5c  h's slope meets 11/20 at", bf_find_root(slope - 11/20, z, 1, 2)),
  print("STEP 5d  the other channel's slope at 0, its steepest:",
        subst(z = 0, diff(z/(2*(1 + z)), z))))$

/* STEP 6 */
block([z, x, phi, budget, worth, along, inside],
  print("STEP 6a  h(z) / z - 1/2, its numerator factored:", factor(num(ratsimp(h(z)/z - 1/2)))),
  print("STEP 6b  the average's slope at 2^(1/3):", ratsimp(subst(z = 2^(1/3), diff(h(z)/z, z)))),
  phi : (1 + sqrt(5))/2,
  print("STEP 6c  phi^2 - phi - 1:", ratsimp(expand(phi^2 - phi - 1)), "; phi =", float(phi)),
  budget : bfloat(2*phi),
  worth : h(x) + h(budget - x),
  along : diff(worth, x),
  /* each channel at most 3, so the first spends between budget - 3 and 3; an odd count of steps
     keeps the even split off the grid, where the derivative is 0 */
  inside : sublist(makelist(budget - 3 + k*(6 - budget)/4001, k, 0, 4000),
                   lambda([s], is(sign(float(subst(x = s, along))) #
                                  sign(float(subst(x = s + (6 - budget)/4001, along)))))),
  print("STEP 6d  sign changes of the worth's derivative along the split:", length(inside)),
  for s in inside do print("  near", float(s), "worth", float(subst(x = s, worth)), "slope before",
                           float(subst(x = s, along))),
  print("STEP 6e  the even split", float(2*h(phi)), "a unit", float(2*h(phi)/budget),
        "; the corner at the cap", float(subst(x = 3, worth))))$
