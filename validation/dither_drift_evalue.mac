/* The dither e-value behind chc.gate.channel_drift_evalues (ADRs 0018 and 0021), in the library's
   own parameterisation.

   A decision applies u_j = p_j + sig_j xi_j, with xi_j ~ N(0, 1) drawn independently of everything
   before it and of the other actions' draws. For state i the residual against the model is
   g_err + (B_ij - Bhat_ij) u_j + rest, where g_err is the model's error in the drift and rest
   holds the noise and the other actions' channel errors times their actions: nothing in it
   multiplies xi_j. The library moves the residual to the radius's edge, r - side eps u_j, with
   side = +1 against growth and -1 against shrinkage, divides by the residual scale sc, and bets
   theta = side th, th >= 0:
       e = exp(theta rt xi - theta^2 rt^2 / 2),   rt = (r - side eps u_j) / sc.

   STEP 1  the exponent is quadratic in xi, and 1 - 2 (its xi^2 coefficient) = (1 - theta k)^2
   STEP 2  E[e | c] = 1 / |1 - theta k| for rt = c + k xi: the nuisance c cancels exactly
   STEP 3  the library's rt is c + k xi with k = (B_ij - Bhat_ij - side eps) sig / sc
   STEP 4  theta k = th (side (B_ij - Bhat_ij) - eps) sig / sc: at most 0 on both sides while
           |B_ij - Bhat_ij| <= eps, so every column is an e-value on the composite null
   STEP 5  the second moment exp(theta^2 c^2 / D) / sqrt(D), D = 1 - 4 theta k + 2 theta^2 k^2
   STEP 6  a dither drawn with v times the stated variance: exp(theta^2 c^2 (v - 1) / 2) at k = 0
   STEP 7  quadrature at the unit test's columns
   STEP 8  a clipped action, read with its draw: 1 - (Phi(u2) - Phi(u1)) (1 - 1/s), s = 1 - theta k,
           at most 1 on the null side and exactly 1 on the edge whatever the clip; the dither as
           applied in its place, and skipping a clipped decision after the draw, are not e-values

   Run: timeout 300 maxima --very-quiet -b validation/dither_drift_evalue.mac */

linel : 110$
display2d : false$
fpprintprec : 10$

/* E exp(a xi + b xi^2), xi ~ N(0, 1), 1 - 2 b > 0: the Gaussian integral every step rests on */
assume(q > 0)$
gauss : integrate(exp(-q*v^2/2), v, minf, inf)/sqrt(2*%pi)$
print("the Gaussian integral int exp(-q v^2/2) dv / sqrt(2 pi) =", gauss,
      " -> E exp(a xi + b xi^2) = exp(a^2 / (2 (1 - 2 b))) / sqrt(1 - 2 b)")$
mgf(a, b) := exp(a^2/(2*(1 - 2*b)))/sqrt(1 - 2*b)$

print("=== STEP 1: the exponent ===")$
ex : theta*(c + k*xi)*xi - theta^2*(c + k*xi)^2/2$
a1 : theta*c*(1 - theta*k)$
b1 : theta*k - theta^2*k^2/2$
print("STEP 1a exponent - (-theta^2 c^2/2 + a1 xi + b1 xi^2) =",
      ratsimp(ex - (-theta^2*c^2/2 + a1*xi + b1*xi^2)), " (0)")$
print("STEP 1b (1 - 2 b1) - (1 - theta k)^2 =", ratsimp((1 - 2*b1) - (1 - theta*k)^2), " (0)")$

print("=== STEP 2: the mean ===")$
/* E^2 = exp(-theta^2 c^2 + a1^2 / (1 - 2 b1)) / (1 - 2 b1), squared to keep sqrt's branch out */
print("STEP 2a -theta^2 c^2 + a1^2 / (1 - theta k)^2 =",
      ratsimp(-theta^2*c^2 + a1^2/(1 - theta*k)^2),
      " (0): the nuisance c cancels, and E^2 = 1/(1 - theta k)^2")$
print("STEP 2b so E[e | c] = 1/|1 - theta k| whatever c: at most 1 iff theta k <= 0 or >= 2")$

print("=== STEP 3: the library's residual at the edge ===")$
u : p + sig*xi$
r : gerr + d*u + rest$          /* d = B_ij - Bhat_ij; gerr and rest do not involve xi */
rt : (r - side*eps*u)/sc$
kk : (d - side*eps)*sig/sc$
cc : ratsimp(rt - kk*xi)$
print("STEP 3a rt - k xi =", cc)$
print("STEP 3b d/dxi (rt - k xi) =", ratsimp(diff(cc, xi)), " (0): c does not involve the dither")$

print("=== STEP 4: the sides ===")$
for s in [1, -1] do
  print("STEP 4 side", s, ": theta k =", factor(ratsimp(subst(side = s, s*th*kk))),
        "<= 0 iff", if s = 1 then "d <= eps" else "d >= -eps", "(sig, sc > 0, th >= 0)")$

print("=== STEP 5: the second moment ===")$
ex2 : ratsimp(2*ex)$
a2 : 2*theta*c*(1 - theta*k)$
b2 : 2*theta*k - theta^2*k^2$
print("STEP 5a 2 exponent - (-theta^2 c^2 + a2 xi + b2 xi^2) =",
      ratsimp(ex2 - (-theta^2*c^2 + a2*xi + b2*xi^2)), " (0)")$
dd : 1 - 4*theta*k + 2*theta^2*k^2$
print("STEP 5b (1 - 2 b2) - D =", ratsimp(1 - 2*b2 - dd), " (0)")$
print("STEP 5c a2^2/(2 D) - theta^2 c^2 - theta^2 c^2 / D =",
      ratsimp(a2^2/(2*dd) - theta^2*c^2 - theta^2*c^2/dd),
      " (0): E[e^2 | c] = exp(theta^2 c^2 / D) / sqrt(D)")$
print("STEP 5d D = 0 at theta k =", solve(2*z^2 - 4*z + 1 = 0, z),
      ": infinite for theta k in [1 - 1/sqrt 2, 1 + 1/sqrt 2]; on the null side D >= 1")$

print("=== STEP 6: a dither wider than stated ===")$
/* xi = sqrt(v) z, z ~ N(0, 1): the exponent in z has coefficients a1 sqrt(v) and b1 v */
mean_v : exp(-theta^2*c^2/2)*mgf(a1*sqrt(v), b1*v)$
print("STEP 6a at k = 0: log E =", ratsimp(radcan(log(subst(k = 0, mean_v)))),
      " = theta^2 c^2 (v - 1) / 2")$
print("STEP 6b theta c = 1, v = 1.2: E =", float(subst([k = 0, theta = 1, c = 1, v = 1.2], mean_v)),
      " (1.10517)")$

print("=== STEP 7: quadrature at the unit test's columns ===")$
check(vc, vk, vth) := block([num],
  num : quad_qagi(exp(vth*(vc + vk*x)*x - vth^2*(vc + vk*x)^2/2)*exp(-x^2/2)/sqrt(2*%pi),
                  x, minf, inf, 'epsrel = 1d-12)[1],
  [num, 1/abs(1 - vth*vk), num*abs(1 - vth*vk) - 1])$
/* test_each_drift_evalue_averages_what_the_dither_identity_says: entry (1, 0) grew 0.1 past a
   radius of 0.05, with sig = 0.5 and sc = 0.25, so k = 0.1 against growth and 0.3 against
   shrinkage; entry (1, 1) sits at the model's with a radius of 0.2, sig = 2 and sc = 0.25 */
print("STEP 7 (c, k, theta) = (0.4, 0.1, 1):", check(0.4, 0.1, 1.0), " (grew: 1/0.9)")$
print("STEP 7 (c, k, theta) = (0.4, 0.3, -1):", check(0.4, 0.3, -1.0), " (1/1.3)")$
print("STEP 7 (c, k, theta) = (-0.7, -1.6, 0.5):", check(-0.7, -1.6, 0.5), " (1/1.8)")$
print("STEP 7 (c, k, theta) = (2.0, 0.0, 1):", check(2.0, 0.0, 1.0), " (on the edge: 1)")$

print("=== STEP 8: a clipped action, read with its draw ===")$
/* A box [lo, hi] clips u = p + sig xi, so the applied dither is sig h(xi), with
   h(xi) = clip(xi, -m1, m2), m1 = (p - lo)/sig, m2 = (hi - p)/sig and -m1 < m2. STEP 3 with
   u = p + sig h gives rt = c + k h, c and k as there, while the bet reads the draw xi. */
u8 : p + sig*hh$
rt8 : (gerr + d*u8 + rest - side*eps*u8)/sc$
print("STEP 8a rt - (c + k h), with h the applied dither over sig =", ratsimp(rt8 - (cc + kk*hh)),
      " (0)")$
/* e phi(xi) = phi(xi - a) for any a, a = theta rt included, which moves with xi */
print("STEP 8b a xi - a^2/2 - xi^2/2 + (xi - a)^2/2 =",
      ratsimp(a*xi - a^2/2 - xi^2/2 + (xi - a)^2/2), " (0)")$
print("STEP 8c between the clips, xi - theta (c + k xi) - (s xi - theta c) =",
      ratsimp(xi - theta*(c + k*xi) - ((1 - theta*k)*xi - theta*c)), " (0), s = 1 - theta k")$
print("STEP 8c at the lower clip, -m1 - theta (c - k m1) - (-s m1 - theta c) =",
      ratsimp(-m1 - theta*(c - k*m1) - (-(1 - theta*k)*m1 - theta*c)), " (0)")$
print("STEP 8c at the upper clip, m2 - theta (c + k m2) - (s m2 - theta c) =",
      ratsimp(m2 - theta*(c + k*m2) - ((1 - theta*k)*m2 - theta*c)), " (0)")$
Phi(z) := (1 + erf(z/sqrt(2)))/2$
phi(z) := exp(-z^2/2)/sqrt(2*%pi)$
/* integrate writes erf((sqrt(2) z)/2) where Phi writes erf(z/sqrt(2)): one form for both */
canon(e) := block([algebraic : true], ratsimp(subst(lambda([z], erf(ratsimp(z))), erf, e)))$
assume(s > 0, m2 > -m1)$
below : integrate(phi(x - a1), x, minf, -m1)$
middle : integrate(phi(s*x - t), x, -m1, m2)$
above : integrate(phi(x - a2), x, m2, inf)$
print("STEP 8d below the lower clip, less Phi(-m1 - a1):", canon(below - Phi(-m1 - a1)), " (0)")$
print("STEP 8d between the clips, less (Phi(s m2 - t) - Phi(-s m1 - t))/s:",
      canon(middle - (Phi(s*m2 - t) - Phi(-s*m1 - t))/s), " (0)")$
print("STEP 8d above the upper clip, less 1 - Phi(m2 - a2):", canon(above - (1 - Phi(m2 - a2))),
      " (0)")$
/* t = theta c, a1 = theta (c - k m1) and a2 = theta (c + k m2), so -m1 - a1 = u1, m2 - a2 = u2 */
total : Phi(u1) + (Phi(u2) - Phi(u1))/s + 1 - Phi(u2)$
print("STEP 8e the mean, less 1 - (Phi(u2) - Phi(u1)) (1 - 1/s):",
      ratsimp(total - (1 - (Phi(u2) - Phi(u1))*(1 - 1/s))), " (0)")$
print("STEP 8e u2 - u1 =", factor(ratsimp((s*m2 - t) - (-s*m1 - t))),
      ": positive, so the mean is at most 1 where s >= 1, theta k <= 0 (STEP 4), and at least 1",
      "where 0 < s < 1")$
print("STEP 8e without a clip, m1 = m2 = inf, the mean is",
      limit(limit(subst([u1 = -s*m1 - t, u2 = s*m2 - t], 1 - (Phi(u2) - Phi(u1))*(1 - 1/s)), m1, inf),
            m2, inf), " (1/s, STEP 2)")$
print("STEP 8e on the edge, s = 1, the mean is",
      ratsimp(subst(s = 1, 1 - (Phi(u2) - Phi(u1))*(1 - 1/s))), " whatever the clip")$

/* The dither as applied, sig h(xi), in the draw's place: at k = 0 the e-value is
   exp(theta c h - theta^2 c^2 / 2), a likelihood ratio for a law that is not h's. The nominal action
   on the lower bound, m1 = 0. */
applied : integrate(phi(x - t), x, 0, inf) + exp(-t^2/2)*integrate(phi(x), x, minf, 0)$
print("STEP 8f the dither as applied, nominal on the lower bound, on the edge: E less Phi(t) +",
      "exp(-t^2/2)/2 =", canon(applied - (Phi(t) + exp(-t^2/2)/2)), " (0), t = theta c")$
print("STEP 8f its largest mean, at t = sqrt(2/pi):",
      float(subst(t = sqrt(2/%pi), Phi(t) + exp(-t^2/2)/2)), " (1.151 > 1: the log carries the draw)")$
/* Skipping a clipped decision after the draw, e = 1 there: on the edge the middle keeps its tilted
   mass and the clipped draws count their untilted chance. A lower clip only. */
skipped : (1 - Phi(-m1 - t)) + Phi(-m1)$
print("STEP 8g skipping after the draw, lower clip, on the edge: E =", skipped,
      "; as theta c grows it tends to", limit(skipped, t, inf), " = 1 + P(clip)")$
print("STEP 8g nominal on the bound, m1 = 0, theta c = 2: E =", float(subst([m1 = 0, t = 2], skipped)))$

print("=== STEP 8h: quadrature against the closed form, and a smooth actuator ===")$
clipped(vc, vk, vth, vm1, vm2) := block([s8, num, closed],
  s8 : 1 - vth*vk,
  num : quad_qagi(exp(vth*(vc - vk*vm1)*x - vth^2*(vc - vk*vm1)^2/2)*phi(x), x, minf, -vm1,
                  'epsrel = 1d-12)[1]
        + quad_qags(exp(vth*(vc + vk*x)*x - vth^2*(vc + vk*x)^2/2)*phi(x), x, -vm1, vm2,
                    'epsrel = 1d-12)[1]
        + quad_qagi(exp(vth*(vc + vk*vm2)*x - vth^2*(vc + vk*vm2)^2/2)*phi(x), x, vm2, inf,
                    'epsrel = 1d-12)[1],
  closed : float(1 - (Phi(s8*vm2 - vth*vc) - Phi(-s8*vm1 - vth*vc))*(1 - 1/s8)),
  [num, closed, num - closed])$
print("STEP 8h (c, k, theta, m1, m2) = (0.7, -0.5, 1, 0, 3):", clipped(0.7, -0.5, 1.0, 0.0, 3.0),
      " (inside the radius)")$
print("STEP 8h (c, k, theta, m1, m2) = (-1.5, -3, 0.25, 1, 2):", clipped(-1.5, -3.0, 0.25, 1.0, 2.0),
      " (inside)")$
print("STEP 8h (c, k, theta, m1, m2) = (3, 0, -1, 0.4, -0.2):", clipped(3.0, 0.0, -1.0, 0.4, -0.2),
      " (the edge, nominal above the box: 1)")$
print("STEP 8h (c, k, theta, m1, m2) = (0.7, 0.6, 1, 1, 2):", clipped(0.7, 0.6, 1.0, 1.0, 2.0),
      " (crossed: above 1, below 1/(1 - 0.6))")$
/* Any action nondecreasing in its own draw: the mean is int phi(g(xi) - theta c) dxi with
   g = xi - theta k h(xi), and g' = 1 - theta k h' >= 1 on the null side, so it is at most 1. A tanh
   actuator, h(xi) = (tanh(p + 0.4 xi) - tanh(p))/0.4: */
smooth(vc, vk, vth, vp) := block([h],
  h : (tanh(vp + 0.4*x) - tanh(vp))/0.4,
  quad_qagi(exp(vth*(vc + vk*h)*x - vth^2*(vc + vk*h)^2/2)*phi(x), x, minf, inf, 'epsrel = 1d-12)[1])$
print("STEP 8h tanh actuator, (c, k, theta, p) = (1.5, -2, 1, 0.8):", smooth(1.5, -2.0, 1.0, 0.8),
      " (inside: at most 1)")$
print("STEP 8h tanh actuator, (c, k, theta, p) = (0, 0, 1, 2):", smooth(0.0, 0.0, 1.0, 2.0),
      " (the edge: 1)")$
