/* C1 END-TO-END, the finite-sample half: an EXACT gain-gap identity, then the explicit ball on
   which a certainty-equivalent controller is guaranteed to stabilise the TRUE plant, and the
   explicit constant in front of ||dB||^2.  Maxima is the authoritative reference; the Python
   certificate (ce_explicit_constant_certificate) and proofs/ce_explicit_constants.v follow it.

   Notation.  (K, P) solve the discrete LQR for the true plant (A, B, Q, R);
   R_K := R + B'PB;  eta := lmin(Q + K'RK)/lmax(P);  theta := 1 - sqrt(1 - eta);
   beta_B := ||P^(1/2) B|| / sqrt(lmin(P));  kappa_P := lmax(P)/lmin(P);
   L_K is the Lipschitz constant of the gain map B |-> K(B).

   The point of STEP 1 is that "quadratic in the gain error" is an EXACT algebraic identity with no
   smallness hypothesis, so the Mania-Tu-Recht local bound is not needed on the regret side. */

print("=== STEP 1: the EXACT gain-gap identity (no smallness assumed) ===")$
kopt  : a*b*p/(r + b^2*p)$
rk    : r + b^2*p$
/* q eliminated through the DARE  p = q + a^2 p r/(r + b^2 p). */
q_dare : p - a^2*p*r/(r + b^2*p)$
gap_id : ratsimp( subst([q = q_dare], q + r*kp^2 + (a - b*kp)^2*p - p) - (kp - kopt)^2*rk )$
print("STEP 1a  [q + r k'^2 + (a - b k')^2 p - p] - (k'-k)^2 R_K =", gap_id,
      " (0 for EVERY k': the Lyapunov increment is a perfect square in the gain error)")$
print("STEP 1b  at k' = k the increment is =",
      ratsimp( subst([kp = kopt, q = q_dare], q + r*kp^2 + (a - b*kp)^2*p - p) ),
      " (0: the DARE is exactly the k' = k case of the identity)")$
print("STEP 1c  R_K > 0 whenever r > 0, p > 0:  R_K - r =", ratsimp(rk - r),
      " (b^2 p >= 0, so R_K >= r > 0 and the square is positive-definite)")$

print("=== STEP 2: the closed-form scalar DARE and its exact contraction ===")$
psol  : solve(b^2*p^2 + (r*(1 - a^2) - q*b^2)*p - q*r = 0, p)$
pstab : rhs(psol[2])$
print("STEP 2a p (stabilising root) =", pstab)$
print("STEP 2b DARE residual at that p =",
      ratsimp( subst([p = pstab], b^2*p^2 + (r*(1 - a^2) - q*b^2)*p - q*r) ),
      " (0 confirms the closed form)")$
acl : ratsimp( a - b*kopt )$
print("STEP 2c a_cl = a - b k =", acl, " (= a r/(r + b^2 p))")$
/* In 1-D lmin(P) = lmax(P) = p, so eta = (q + r k^2)/p and 1 - eta = a_cl^2 with NO slack:
   the P-metric contraction modulus of the optimal loop is exactly |a_cl|. */
print("STEP 2d  [1 - eta] - a_cl^2  with eta = (q + r k^2)/p =",
      ratsimp( subst([q = q_dare], 1 - (q + r*kopt^2)/p - acl^2) ),
      " (0: sqrt(1 - eta) = |a_cl| EXACTLY in 1-D, so theta = 1 - |a_cl|)")$

print("=== STEP 3: L_K in closed form -- in the scalar case it needs NO citation ===")$
/* p depends on b through the DARE, so dk/db is a total derivative.  Implicit differentiation of
   F(p,b) := b^2 p^2 + (r(1-a^2) - q b^2) p - q r = 0 keeps the expression readable. */
Fpb  : b^2*p^2 + (r*(1 - a^2) - q*b^2)*p - q*r$
dpdb : ratsimp( -diff(Fpb, b)/diff(Fpb, p) )$
print("STEP 3a dp/db = -F_b/F_p =", dpdb)$
dkdb : ratsimp( diff(kopt, b) + diff(kopt, p)*dpdb )$
print("STEP 3b L_K = dk/db =", dkdb)$
print("STEP 3c dk/db at a = 1, b = 1, q = 1, r = 1, p = golden root =",
      float( subst([a = 1, b = 1, q = 1, r = 1],
                   subst([p = subst([a = 1, b = 1, q = 1, r = 1], pstab)], dkdb)) ))$
print("STEP 3d denominator of dk/db =", denom(dkdb),
      " (the gain map is smooth wherever the stabilising root is simple)")$

print("=== STEP 4: the stabilising ball -- the perturbed loop still contracts in the P metric ===")$
/* ||P^(1/2)(A - B Khat) P^(-1/2)|| <= sqrt(1 - eta) + beta_B ||dK||  and  ||dK|| <= L_K ||dB||.
   Requiring beta_B L_K ||dB|| <= theta/2 forces the modulus below 1 - theta/2 < 1. */
mod_pert : sqrt(1 - eta) + beta_B*lk*db$
rho_def  : theta/(2*beta_B*lk)$
print("STEP 4a modulus at ||dB|| = rho =",
      ratsimp( subst([db = rho_def, sqrt(1 - eta) = 1 - theta], mod_pert) ),
      " (= 1 - theta/2: the Lyapunov certificate (A - B Khat)' P (A - B Khat) <= (1-theta/2)^2 P)")$
print("STEP 4b stability margin 1 - modulus =",
      ratsimp( 1 - subst([db = rho_def, sqrt(1 - eta) = 1 - theta], mod_pert) ),
      " (theta/2 > 0 whenever eta > 0: strictly stable, with an EXPLICIT margin)")$
print("STEP 4c rho is monotone increasing in theta:  drho/dtheta =",
      ratsimp( diff(rho_def, theta) ),
      " (positive: a faster nominal loop tolerates a bigger model error)")$
print("STEP 4d rho falls like 1/L_K:  drho/dL_K =", ratsimp( diff(rho_def, lk) ),
      " (negative: a stiffer gain map shrinks the certified ball)")$

print("=== STEP 5: the explicit constant C ===")$
/* Summing the STEP 1 identity along the perturbed loop:
     J(Khat) - J* = sum_t x_t' dK' R_K dK x_t,   ||x_t||^2 <= kappa_P (1-theta/2)^(2t) ||x0||^2. */
geo_cf : 1/(1 - (1 - theta/2)^2)$
print("STEP 5a sum_t (1 - theta/2)^(2t) =", ratsimp(geo_cf), " (= 4/(theta(4 - theta)))")$
print("STEP 5b geometric-series check  geo*(1 - (1-theta/2)^2) - 1 =",
      ratsimp( geo_cf*(1 - (1 - theta/2)^2) - 1 ), " (0)")$
print("STEP 5c  [2/theta] - [4/(theta(4-theta))] =", ratsimp(2/theta - geo_cf),
      " (= 2(2-theta)/(theta(4-theta)) >= 0 for 0 < theta <= 1, so 2/theta is a VALID relaxation)")$
c_def : 2*kappa_P*rknorm*lk^2*x0sq/theta$
print("STEP 5d C =", c_def, "  = 2 kappa_P ||R_K|| L_K^2 ||x0||^2 / theta")$
print("STEP 5e dC/dtheta =", ratsimp(diff(c_def, theta)),
      " (negative: a slower closed loop costs more, as it must)")$
print("STEP 5f the product rho^2 C =", ratsimp( rho_def^2*c_def ),
      " = kappa_P ||R_K|| ||x0||^2 theta / (2 beta_B^2): the worst certified regret AT the edge of",
      "the ball is INDEPENDENT of L_K -- a stiffer gain map shrinks the ball exactly as fast as it",
      "inflates the constant")$

print("=== STEP 6: the expansion -- the constant is the right ORDER, not merely an upper bound ===")$
declare(s2, constant)$
reg_exact : dk^2*rkn*x0sq/(1 - s2)$   /* scalar: sum_t a_cl^(2t) x0^2 dK^2 R_K, s2 := a_cl^2 < 1 */
print("STEP 6a exact scalar regret in the gain error =", reg_exact)$
print("STEP 6b taylor in dk to order 3 =", taylor(reg_exact, dk, 0, 3),
      " (EXACTLY quadratic: no linear term, no cubic correction -- the identity is not a truncation)")$
print("STEP 6c regret/dk^2 =", ratsimp(reg_exact/dk^2),
      " (independent of dk: the 'quadratic' claim is an equality, not an asymptotic statement)")$

print("=== STEP 7: the 2x2 repo plant, to certified high precision ===")$
/* algsys DOES return four branches here, but its roots are numeric and leave a DARE residual of
   order 1e-4 -- lqr_care.mac already warns not to trust them.  So the plant constants are computed
   by Riccati iteration in bfloat and the residual is printed: a CERTIFIED numerical solution, not a
   closed form.  All the exact content is STEPS 1-6, which are general and symbolic. */
fpprec : 60$
Am : matrix([1, 1/10], [0, 19/20])$
Bm : matrix([1/2], [1])$
Qm : ident(2)$
Rm : matrix([1/2])$
Pit : bfloat(Qm)$
for it : 1 thru 400 do block(
  [sS : bfloat( (Rm + transpose(Bm) . Pit . Bm)[1,1] ),
   Wm : bfloat( transpose(Am) . Pit . Bm )],
  Pit : bfloat( transpose(Am) . Pit . Am - (Wm . transpose(Wm))/sS + Qm ))$
sSb  : bfloat( (Rm + transpose(Bm) . Pit . Bm)[1,1] )$
Wmb  : bfloat( transpose(Am) . Pit . Bm )$
resid : bfloat( transpose(Am) . Pit . Am - Pit - (Wmb . transpose(Wmb))/sSb + Qm )$
print("STEP 7a DARE residual (must be ~0 at 60 digits) =",
      lmax(map(lambda([x], abs(x)), flatten(args(resid)))))$
print("STEP 7b P =", float(Pit))$
Knum : bfloat( transpose(Wmb)/sSb )$
print("STEP 7c K =", float(Knum))$
Aclb : bfloat( Am - Bm . Knum )$
print("STEP 7d A - BK =", float(Aclb))$
print("STEP 7e R_K = R + B'PB =", float(sSb))$
/* The plant constants that enter rho and C. */
ev_P  : bfloat( eigenvalues(Pit)[1] )$
ev_QK : bfloat( eigenvalues(Qm + transpose(Knum) . Rm . Knum)[1] )$
lminP : lmin(map(lambda([x], float(x)), ev_P))$
lmaxP : lmax(map(lambda([x], float(x)), ev_P))$
eta_n : lmin(map(lambda([x], float(x)), ev_QK))/lmaxP$
theta_n : 1 - sqrt(1 - eta_n)$
kappaP  : lmaxP/lminP$
print("STEP 7f lmin(P) =", lminP, " lmax(P) =", lmaxP, " kappa_P =", kappaP)$
print("STEP 7g eta =", eta_n, " theta =", theta_n)$
/* beta_B = ||P^(1/2) B||/sqrt(lmin(P)); ||P^(1/2)B||^2 = B'PB. */
bPb   : float(sSb) - 1/2$          /* B'PB = R_K - R, and R_K is already scalar */
betaB : sqrt(bPb)/sqrt(lminP)$
print("STEP 7h beta_B =", betaB,
      " (in 1-D this collapses to |b|: sqrt(p b^2)/sqrt(p))")$

print("=== STEP 8: the identity again, MATRIX form, on that plant ===")$
Kp   : matrix([kk1, kk2])$
lhsM : Qm + transpose(Kp) . Rm . Kp + transpose(Am - Bm . Kp) . Pit . (Am - Bm . Kp) - Pit$
rhsM : bfloat( transpose(Kp - Knum) . (Kp - Knum) * sSb )$
resM : expand( bfloat(lhsM - rhsM) )$
print("STEP 8 matrix identity residual (max |entry| over kk1, kk2 free) =",
      lmax(map(lambda([x], abs(float(subst([kk1 = 3, kk2 = -2], x)))), flatten(args(resM)))),
      " (0 up to the precision of P: EXACT for every gain, with no smallness anywhere)")$
