/* The spread over logs of the share of the plant's paths a tube calibrated on average holds
   (chc.decision._per_log_spread, ADR 0138).

   One state: the plant's noise has standard deviation sigma, and one log's fitted field is off by
   kappa sigma W, W standard normal across logs, which every path of that log shares. The radius
   z sqrt(1 + kappa^2) sigma holds the two together with probability 0.95, z the normal's
   two-sided 0.95 quantile. One log's share is

       C(W) = Phi(z sqrt(1 + kappa^2) - kappa W) - Phi(-z sqrt(1 + kappa^2) - kappa W).

   E C(W)^2 is the chance that two paths of one log both lie within the radius: Y_i = (kappa W +
   n_i) / sqrt(1 + kappa^2) are standard normals at correlation r = kappa^2 / (1 + kappa^2), so
   E C^2 = P(|Y_1| <= z, |Y_2| <= z). With Owen's T (Owen 1956), Phi2(h, h; r) = Phi(h) -
   2 T(h, s), s = sqrt((1 - r) / (1 + r)) = 1 / sqrt(1 + 2 kappa^2), and P(Y_1 <= z, Y_2 <= -z)
   = 2 T(z, 1 / s), so

       E C^2 = 1 - 4 T(z, s) - 4 T(z, 1 / s),   Var C = 4 (2 T(z, 1) - T(z, s) - T(z, 1 / s)),

   the second since 8 T(z, 1) = 4 Phi(z) Phi(-z) = 1 - 0.95^2.

   Checked here:
   (1) s^2 = (1 - r) / (1 + r) = 1 / (1 + 2 kappa^2), symbolic;
   (2) T(h, 1) = Phi(h) Phi(-h) / 2 at h = z and at h = 1/2, 1, 3 by quadrature, and
       8 T(z, 1) = 1 - 0.95^2;
   (3) E C, E C^2 by quadrature over W against the closed form, at kappa = 1/2, 1, 2: the mean is
       0.95, the spread 0.032443, 0.082181, 0.139435;
   (4) the spread as kappa grows: T(z, a) -> Phi(-z) / 2 and T(z, 1/a) -> 0 as a -> inf, so
       Var C -> 4 (Phi(z) Phi(-z) - Phi(-z) / 2) = 0.95 * 0.05;
   (5) at kappa = 1, the share of logs that hold less than 0.90: 0.13617;
   (6) the kappa whose spread is 0.077 is 0.9410, and 0.0078's is 0.2249.
*/
load(distrib)$
display2d : false$
ratprint : false$
/* a check that fails stops the batch with "-- an error.", which validation/run_all.sh reads */
vanishes(label, x) := if is(x = 0) then print(label, "= 0") else error(label, "is not zero:", x)$
near(label, x, y, tol) := if is(abs(x - y) <= tol) then print(label, x, "(PASS)")
                           else error(label, x, "against", y, "(FAIL)")$

z : quantile_normal(0.975, 0, 1)$
Phi(x) := float((1 + erf(x / sqrt(2))) / 2)$
/* over [0, a] in two pieces: on one long interval QUADPACK misses the mass near 0 */
owenpart(h, lo, hi) := first(quad_qags(exp(-h^2 * (1 + x^2) / 2) / (1 + x^2), x, lo, hi,
                                       'epsrel = 1e-13, 'epsabs = 1e-17))$
owen(h, a) := (owenpart(h, 0, min(a, 8)) + (if a > 8 then owenpart(h, 8, a) else 0))
              / (2 * float(%pi))$
gauss(w) := exp(-w^2 / 2) / sqrt(2 * float(%pi))$
content(w, k) := Phi(z * sqrt(1 + k^2) - k * w) - Phi(-z * sqrt(1 + k^2) - k * w)$
moment(k, j) := first(quad_qagi(content(w, k)^j * gauss(w), w, minf, inf, 'epsrel = 1e-13))$
spread(k) := block([a : sqrt(1 + 2 * k^2)],
  sqrt(max(4 * (2 * owen(z, 1) - owen(z, a) - owen(z, 1 / a)), 0)))$

/* (1) */
vanishes("(1) (1 - r)/(1 + r) - 1/(1 + 2 kappa^2), r = kappa^2/(1 + kappa^2)",
         ratsimp((1 - kappa^2 / (1 + kappa^2)) / (1 + kappa^2 / (1 + kappa^2))
                 - 1 / (1 + 2 * kappa^2)))$

/* (2) */
for h in [0.5, 1.0, 3.0, z] do
  near(sconcat("(2) T(", h, ", 1) - Phi(h) Phi(-h)/2:"), owen(h, 1) - Phi(h) * Phi(-h) / 2, 0, 1e-15)$
near("(2) 8 T(z, 1) - (1 - 0.95^2):", 8 * owen(z, 1) - (1 - 0.95^2), 0, 1e-14)$

/* (3) */
for k in [0.5, 1.0, 2.0] do block([m1, m2, a],
  m1 : moment(k, 1), m2 : moment(k, 2), a : sqrt(1 + 2 * k^2),
  near(sconcat("(3) kappa = ", k, ": E C - 0.95"), m1 - 0.95, 0, 1e-12),
  near(sconcat("(3) kappa = ", k, ": E C^2 - (1 - 4 T(z, s) - 4 T(z, 1/s))"),
       m2 - (1 - 4 * owen(z, 1 / a) - 4 * owen(z, a)), 0, 1e-12),
  print("(3) kappa =", k, " per-log spread", spread(k), " by quadrature", sqrt(m2 - m1^2)))$
near("(3) spread at kappa 1/2", spread(0.5), 0.032443, 5e-7)$
near("(3) spread at kappa 1", spread(1.0), 0.082181, 5e-7)$
near("(3) spread at kappa 2", spread(2.0), 0.139435, 5e-7)$

/* (4) */
near("(4) T(z, inf) - Phi(-z)/2",
     first(quad_qagi(exp(-z^2 * (1 + x^2) / 2) / (1 + x^2), x, 0, inf, 'epsrel = 1e-13))
     / (2 * float(%pi)) - Phi(-z) / 2, 0, 1e-14)$
near("(4) T(z, 1e8) - Phi(-z)/2", owen(z, 1e8) - Phi(-z) / 2, 0, 1e-12)$
near("(4) 4 (Phi(z) Phi(-z) - Phi(-z)/2) - 0.95 * 0.05",
     4 * (Phi(z) * Phi(-z) - Phi(-z) / 2) - 0.95 * 0.05, 0, 1e-15)$
near("(4) spread at kappa 1e4 against sqrt(0.95 * 0.05)", spread(1e4), sqrt(0.95 * 0.05), 1e-3)$

/* (5) C(w) is even in w and falls as |w| grows, so P(C < c) = 2 P(W > w_c), C(w_c) = c */
wc : find_root(lambda([w], content(w, 1.0) - 0.90), 0.0, 10.0)$
near("(5) at kappa 1, P(C < 0.90)", 2 * (1 - Phi(wc)), 0.13617, 5e-6)$

/* (6) */
near("(6) kappa at spread 0.077", find_root(lambda([k], spread(k) - 0.077), 0.2, 3.0), 0.9410, 5e-5)$
near("(6) kappa at spread 0.0078", find_root(lambda([k], spread(k) - 0.0078), 0.01, 0.5), 0.2249,
     5e-5)$
