/* The spread over logs of the share of the plant's paths a radius holds, at any radius and with
   the radius's own read (chc.decision._per_log_spread with radius= and read=).

   One state: the plant's noise has standard deviation 1, and one log's fitted path is off by an
   offset kappa W, W standard normal across logs, which every path of that log shares. The radius
   is rho, which need not hold 0.95 on average: the box's form reads the field's error at a bound,
   and the radius is then wider. One log's share is

       C(W) = Phi(rho - kappa W) - Phi(-rho - kappa W),

   E C = 2 Phi(h) - 1 and E C^2 = 1 - 4 T(h, a) - 4 T(h, 1 / a), h = rho / sqrt(1 + kappa^2),
   a = sqrt(1 + 2 kappa^2), T Owen's (Owen 1956), the second the chance that two paths of one log
   lie within the radius, a bivariate normal's at correlation kappa^2 / (1 + kappa^2), with
   Phi2(h, h; r) = Phi(h) - 2 T(h, s), s = sqrt((1 - r) / (1 + r)) = 1 / a. So

       Var C = 4 (2 T(h, 1) - T(h, a) - T(h, 1 / a)),

   since 2 T(h, 1) = Phi(h) Phi(-h) and (2 Phi(h) - 1)^2 = 1 - 4 Phi(h) Phi(-h).

   Each log reads its radius with its own error: rho_D = rho + d D, D standard normal and
   independent of W. Then Var C = E_D Var(C | D) + Var_D E(C | D), the law of total variance,
   and the library takes both outer means by Gauss-Hermite quadrature.

   Checked here:
   (1) E C and E C^2 by quadrature over W against the closed forms, at (rho, kappa) off the
       calibrated radius: (2.6, 1/2), (3, 1), (2.2, 1/10), (1.5, 2);
   (2) Var C = 4 (2 T(h, 1) - T(h, a) - T(h, 1/a)) against the quadrature's E C^2 - (E C)^2 there,
       and at h = z it is the calibrated radius's spread, tube_per_log_content.mac's;
   (3) with the read, the variance by a double quadrature over D and W against the library's
       values at (kappa, rho, d) = (0, 1.96, 0.05), (1/2, 2.6, 0.1), (1, 3, 0.2), (1/10, 2.2, 0.08),
       and at d = 0 against (2) at (1/2, 2.6) and (1, 3);
   (4) at kappa = 0 and a small read, the spread is the radius's alone, 2 phi(rho) d to first
       order: the read is what spreads a log's share where the field's error is negligible.
*/
load(distrib)$
display2d : false$
ratprint : false$
fpprec : 20$
near(label, x, y, tol) := if is(abs(x - y) <= tol) then print(label, x, "(PASS)")
                           else error(label, x, "against", y, "(FAIL)")$

z : quantile_normal(0.975, 0, 1)$
Phi(x) := float((1 + erf(x / sqrt(2))) / 2)$
phi(x) := float(exp(-x^2 / 2) / sqrt(2 * %pi))$
/* over [0, a] in two pieces: on one long interval QUADPACK misses the mass near 0 */
owenpart(h, lo, hi) := first(quad_qags(exp(-h^2 * (1 + x^2) / 2) / (1 + x^2), x, lo, hi,
                                       'epsrel = 1e-13, 'epsabs = 1e-17))$
owen(h, a) := (owenpart(h, 0, min(a, 8)) + (if a > 8 then owenpart(h, 8, a) else 0))
              / (2 * float(%pi))$
content(w, r, k) := Phi(r - k * w) - Phi(-r - k * w)$
moment(r, k, j) := first(quad_qagi(content(w, r, k)^j * phi(w), w, minf, inf, 'epsrel = 1e-13))$
closedvar(r, k) := block([h : r / sqrt(1 + k^2), a : sqrt(1 + 2 * k^2)],
  4 * (2 * owen(h, 1) - owen(h, a) - owen(h, 1 / a)))$

/* (1), (2) */
for p in [[2.6, 0.5], [3.0, 1.0], [2.2, 0.1], [1.5, 2.0]] do block(
  [r : p[1], k : p[2], h, a, m1, m2],
  h : r / sqrt(1 + k^2), a : sqrt(1 + 2 * k^2),
  m1 : moment(r, k, 1), m2 : moment(r, k, 2),
  near(sconcat("(1) rho ", r, " kappa ", k, ": E C - (2 Phi(h) - 1)"), m1 - (2 * Phi(h) - 1), 0,
       1e-12),
  near(sconcat("(1) rho ", r, " kappa ", k, ": E C^2 - (1 - 4 T(h, a) - 4 T(h, 1/a))"),
       m2 - (1 - 4 * owen(h, a) - 4 * owen(h, 1 / a)), 0, 1e-12),
  near(sconcat("(2) rho ", r, " kappa ", k, ": Var C - 4 (2 T(h,1) - T(h,a) - T(h,1/a))"),
       (m2 - m1^2) - closedvar(r, k), 0, 1e-12),
  print("(2) rho", r, "kappa", k, " spread", sqrt(closedvar(r, k))))$
near("(2) at h = z, kappa 1: the calibrated spread 0.0821814200157",
     sqrt(closedvar(z * sqrt(2.0), 1.0)), 0.0821814200157158550, 1e-12)$

/* (3) inner over W in closed form ((1) checked it), outer over D by quadrature; and the double
   quadrature itself at one point */
/* integrands as named functions of u alone, over the globals rr, kk, dd, mm, so that QUADPACK
   calls them at numbers: Owen's T is itself a quadrature */
gwithin(u) := closedvar(max(rr + dd * u, 0), kk) * phi(u)$
meanat(r, k) := 2 * Phi(r / sqrt(1 + k^2)) - 1$
gmean(u) := meanat(max(rr + dd * u, 0), kk) * phi(u)$
gbetween(u) := (meanat(max(rr + dd * u, 0), kk) - mm)^2 * phi(u)$
spreadread(r, k, d) := block([within],
  rr : r, kk : k, dd : d,
  within : first(quad_qagi(gwithin, u, minf, inf, 'epsrel = 1e-12)),
  mm : first(quad_qagi(gmean, u, minf, inf, 'epsrel = 1e-13)),
  sqrt(within + first(quad_qagi(gbetween, u, minf, inf, 'epsrel = 1e-12, 'epsabs = 1e-20))))$
/* the library's values, chc.decision._per_log_spread(kappa, rho, d), at 40 nodes */
library : [[0.0, 1.96, 0.05, 0.005878847419593827], [0.5, 2.6, 0.1, 0.018799216824930663],
           [1.0, 3.0, 0.2, 0.0685919161380619], [0.1, 2.2, 0.08, 0.006005493932562051],
           [0.5, 2.6, 0.0, 0.017737391390399104], [1.0, 3.0, 0.0, 0.06506887583031318]]$
for p in library do block([k : p[1], r : p[2], d : p[3], v : p[4], q],
  q : if d = 0.0 then sqrt(closedvar(r, k)) else spreadread(r, k, d),
  near(sconcat("(3) kappa ", k, " rho ", r, " read ", d, ": library - quadrature"), v - q, 0,
       1e-10))$
/* the double quadrature, C's own moments over W and then D, at (1/2, 2.6, 0.1) */
jj : 1$
gdouble(u) := moment(2.6 + 0.1 * u, 0.5, jj) * phi(u)$
double1 : first(quad_qags(gdouble, u, -10, 10, 'epsrel = 1e-11))$
jj : 2$
double2 : first(quad_qags(gdouble, u, -10, 10, 'epsrel = 1e-11))$
near("(3) double quadrature at (1/2, 2.6, 0.1) - library", sqrt(double2 - double1^2),
     0.018799216824930663, 1e-9)$

/* (4) */
near("(4) kappa 0, rho z, read 1e-3: spread / (2 phi(z) d)",
     spreadread(z, 0.0, 1e-3) / (2 * phi(z) * 1e-3), 1.0, 1e-5)$
