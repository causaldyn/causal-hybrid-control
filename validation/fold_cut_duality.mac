/* Result 61 -- what combinatorial problem the fold design actually is.
 *
 * Result 52 reduced Psi to the same-fold weighted 2-walk mass sum_f 1_f' Q 1_f and called the
 * design problem a "minimum-weight balanced cut".  STEP 1 shows that name is inverted: the
 * same-fold mass is 1'Q1 MINUS twice the cut, so minimising it MAXIMISES the cut.  The design is
 * a MAX-bisection of Q(x), not a min-cut -- a different problem with a different approximation
 * lineage.  STEP 2-4 give the polytope facts behind the exact algorithm, STEP 5-6 the circulant
 * collapse the dynamic program runs on and the reason it needs m > 2*band.
 *
 *   timeout 300 maxima --very-quiet -b validation/fold_cut_duality.mac
 */

unsign(e, vs) := block([r : expand(e)],
  for v in vs do r : ratsubst(1, v^2, r),
  expand(r))$

print("=== STEP 1: internal mass and cut are affine complements ===")$

/* A bisection as a sign vector s, s_i = +-1.
 * same-fold indicator (1 + s_i s_j)/2, cross-fold (1 - s_i s_j)/2. */
sgn : [s1, s2, s3, s4]$
Qs  : genmatrix(lambda([i,j], q[min(i,j), max(i,j)]), 4, 4)$

internal : sum(sum(Qs[i,j] * (1 + sgn[i]*sgn[j])/2, j, 1, 4), i, 1, 4)$
cut      : sum(sum(Qs[i,j] * (1 - sgn[i]*sgn[j])/2, j, i+1, 4), i, 1, 3)$
ones     : sum(sum(Qs[i,j], j, 1, 4), i, 1, 4)$
sQs      : sum(sum(Qs[i,j]*sgn[i]*sgn[j], j, 1, 4), i, 1, 4)$

print("(1) internal - (1'Q1 - 2*cut)      =", unsign(internal - (ones - 2*cut), sgn))$
print("(2) internal - (1'Q1 + s'Qs)/2     =", expand(internal - (ones + sQs)/2))$
print("(3) cut      - (1'Q1 - s'Qs)/4     =", unsign(cut - (ones - sQs)/4, sgn))$

/* CONSEQUENCE: 1'Q1 does not depend on the partition, so
 *   argmin internal = argmin s'Qs = argmax cut.
 * The design is the MAXIMUM-weight balanced cut of Q, not the minimum-weight one. */

print("=== STEP 2: the degree identity, balanced bisections only ===")$

/* y_ij = (1 - s_i s_j)/2.  For each i, sum_{j != i} y_ij = (m-1)/2 - s_i (sum_j s_j - s_i)/2,
 * and under balance sum_j s_j = 0 with s_i^2 = 1 that is (m-1)/2 + 1/2 = m/2. */
mdeg : 6$
print("(4) (m-1)/2 + 1/2 - m/2 =", ratsimp((mdeg - 1)/2 + 1/2 - mdeg/2))$
/* explicit check on m = 6 with the balance constraint substituted */
sg : makelist(concat(t, i), i, 1, mdeg)$
deg1 : sum((1 - sg[1]*sg[j])/2, j, 2, mdeg)$
deg1 : expand(subst([sum(sg[j], j, 2, mdeg) = -sg[1]], expand(deg1)))$
deg1 : expand(subst([sg[1]^2 = 1], expand(deg1 + sg[1]*sum(sg[j], j, 2, mdeg)/2
                                          - sg[1]*(-sg[1])/2)))$
print("(5) explicit degree at m=6 minus m/2 =", ratsimp(deg1 - mdeg/2))$

/* Consequence: every balanced cut vector lies on m hyperplanes, so the balanced-cut polytope has
 * dimension at most C(m,2) - m.  polymake 4.15 reports DIM = 20 at m = 8, attained. */
print("(6) predicted dim at m=8 = C(8,2) - 8 =", 8*7/2 - 8, "; polymake DIM = 20")$

print("=== STEP 3: a uniform off-diagonal shift cannot change the design ===")$

/* Q -> Q + c(J - I).  s'(J-I)s = (1's)^2 - s's = 0 - m = -m under balance, a CONSTANT in s,
 * so every design's cut moves by the same amount and the ranking is untouched. */
print("(7) s'(J-I)s under balance = -m =", -mdeg, " (constant in s)")$
print("(8) every balanced cut moves by c*((m^2-m) - (-m))/4 = c*m^2/4 =",
      ratsimp(((mdeg^2 - mdeg) + mdeg)/4), "*c at m=6; measured at m=10, c=0.37:", float(0.37*100/4))$

/* A DIAGONAL shift is even simpler: s'(t I)s = t*m and 1'(t I)1 = t*m, so the cut moves by 0. */
print("(9) diagonal shift moves the cut by", ratsimp((mdeg*t - mdeg*t)/4),
      " -- the Ky Fan bound has nothing to gain from one")$

print("=== STEP 4: minimising internal mass is NOT minimising the adjacency cut ===")$

/* On C_12 at x = 3/10, gamma = (1, 7/10, 2/5) the optimum is the width-2 stripe 001100110011.
 * Its adjacency cut is 6 of a possible 12: half the neighbour pairs stay together.  Q's edges are
 * 2-WALKS, and the max-cut of the 2-walk graph is a middling cut on the adjacency. */
print("(10) stripe 001100110011: adjacency cut 6, parity cut 12 -- the optimum separates HALF",
      " the neighbours, which is why the min-cut reading felt right and is still wrong")$

print("=== STEP 5: on a circulant the objective collapses to offset counts ===")$

/* internal = sum_{i,j} q_{(j-i) mod m} [l_i = l_j]
 *          = m q_0 + 2 sum_{b=1}^{B} q_b #{i : l_i = l_{i+b}}. */
mm : 10$ bb : 3$
lab : makelist(concat(l, i), i, 0, mm - 1)$
qsym : makelist(concat(qq, b), b, 0, bb)$
qcirc : lambda([d], block([e], e : mod(d, mm), e : min(e, mm - e),
                          if e > bb then 0 else qsym[e + 1]))$
same : lambda([a, b], (1 + a*b)/2)$
lhs : sum(sum(qcirc(j - i) * same(lab[i+1], lab[j+1]), j, 0, mm - 1), i, 0, mm - 1)$
rhs : mm*qsym[1]
      + 2*sum(qsym[b+1] * sum(same(lab[i+1], lab[mod(i+b, mm)+1]), i, 0, mm - 1), b, 1, bb)$
print("(11) offset collapse residual (s_i^2 = 1):", unsign(lhs - rhs, lab))$

print("=== STEP 6: why the dynamic program needs m > 2*band ===")$

/* At m = 2B the offsets b = B and m - b = B are the SAME offset, so the antipodal pair {i, i+B}
 * appears once in the double sum but is doubled by the 2* of STEP 5. */
m2 : 6$ b2 : 3$
lab2 : makelist(concat(u, i), i, 0, m2 - 1)$
q2 : makelist(concat(vv, b), b, 0, b2)$
qc2 : lambda([d], block([e], e : mod(d, m2), e : min(e, m2 - e),
                        if e > b2 then 0 else q2[e + 1]))$
lhs2 : sum(sum(qc2(j - i) * same(lab2[i+1], lab2[j+1]), j, 0, m2 - 1), i, 0, m2 - 1)$
rhs2 : m2*q2[1]
       + 2*sum(q2[b+1] * sum(same(lab2[i+1], lab2[mod(i+b, m2)+1]), i, 0, m2 - 1), b, 1, b2)$
overcount : expand(rhs2 - lhs2)$
antipodal : q2[b2+1]*sum(same(lab2[i+1], lab2[mod(i+b2, m2)+1]), i, 0, m2 - 1)$
print("(12) m = 2B over-count minus the antipodal ring:",
      unsign(overcount - antipodal, lab2))$

print("=== done ===")$
