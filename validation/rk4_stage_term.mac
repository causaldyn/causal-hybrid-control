/* The term of order dt^2 RK4's step adds to the field's error: each stage reads it where it reads
   the field (chc.decision._field_errors, ADR 0141).

   The fitted field is off by H(x, u) theta, theta the fit's error of covariance Sigma. One RK4
   step from x moves with theta by dt sum_i c_i(z) H(x_i, u) theta, x_i the step's stage states and
   c_1 .. c_4 the weights its stages put on the field's errors, (1 + z + z^2/2 + z^3/4)/6,
   (2 + z + z^2/2)/6, (2 + z)/6 and 1/6, z = dt a (chc.uncertainty._rk4_parts). Up to 0.22.0 the
   tube read the error at the step's start alone, dt S(z) H(x, u) theta with S = sum_i c_i, which
   drops dt sum_i c_i (H(x_i, u) - H(x, u)) theta: of the order of dt^2, the field's own move along
   the step times the error's slope in the state. It is not one of the terms the rk4 fit's error
   inherits through its fixed point (rk4_inherited.mac (3), (4)): those make Sigma, which every
   stage reads; this one is where the stages read it.

   Checked here:
   (1) on a scalar field affine in the state, f = a x + q, moved by an error affine in the state,
       e0 + e1 x: the RK4 step's derivative in the error is dt sum_i c_i(z) (e0 + e1 x_i), exactly;
       sum_i c_i = S;
   (2) the term the start's read drops is dt^2 S'(z) e1 f(x) exactly, S'(0) = 1/2
       (plan_action_tube.mac (2)), and nothing where the error does not move with the state;
   (3) the Euler map reads its one stage at the start: its derivative is dt (e0 + e1 x), and the
       start's read drops nothing;
   (4) at rk4_inherited.mac's rational point, the rk4 fit's error Sigma = K^-1 G (K^-1 G)', theta =
       (c, a, b, p): the step's derivative is h sum_i c_i(z) (1, x_i, u, w), and times K^-1 G it
       is h (1, x, u, w) (X'X)^-1 X', least squares' one-step prediction, an exact oracle; ADR
       0133's V_full = V_cond + L^2 V_b + 2 L cross holds at each stage's state; the one-step
       error's standard deviation, the start's read, and each stage read on its own, its weight
       times its standard deviation summed: the stages' read within 2 % above the step's error,
       the start's off it by more than 5 %, over at x = 2 (the stages move toward the log's
       states) and under at x = 0, u = 2 (away);
   (5) the stages read on their own bound the step's error (Minkowski), carried by any matrix:
       sqrt(tr(M Sigma M')) <= sum_i ||G c_i|| sqrt(tr(H_i Sigma H_i')), M = G sum_i c_i H_i, at a
       rational two-state point;
   (6) the stage's variance in the action: where the channel does not read the state, the stage
       states move affinely with the action and the variance is a convex quadratic in it, read at
       the box's vertices; where it does (a bilinear channel) the third stage's state is quadratic
       in the action and its variance of degree 6 in it.
*/
display2d : false$
ratprint : false$
/* a check that fails stops the batch with "-- an error.", which validation/run_all.sh reads */
vanishes(label, x) := if (if matrixp(x) then every(lambda([e], is(e = 0)), flatten(args(x)))
                          else if listp(x) then every(lambda([e], is(e = 0)), x)
                          else is(x = 0))
  then print(label, "= 0") else error(label, "is not zero:", x)$
holds(label, claim) := if is(claim) then print(label, "(PASS)") else error(label, "(FAIL)")$
R(z) := 1 + z + z^2/2 + z^3/6 + z^4/24$
S(z) := 1 + z/2 + z^2/6 + z^3/24$
Sp(z) := 1/2 + z/3 + z^2/8$
Rp(z) := 1 + z + z^2/2 + z^3/6$
cw(z) := [(1 + z + z^2/2 + z^3/4)/6, (2 + z + z^2/2)/6, (2 + z)/6, 1/6]$

/* (1) */
stages(x, fld) := block([k1, k2, k3, s2, s3, s4],
  k1 : fld(x), s2 : x + dt/2*k1, k2 : fld(s2), s3 : x + dt/2*k2, k3 : fld(s3), s4 : x + dt*k3,
  [x, s2, s3, s4])$
f0(x) := a*x + q$
moved(x) := a*x + q + e*(e0 + e1*x)$
rk(x, fld) := block([k1, k2, k3, k4],
  k1 : fld(x), k2 : fld(x + dt/2*k1), k3 : fld(x + dt/2*k2), k4 : fld(x + dt*k3),
  x + dt/6*(k1 + 2*k2 + 2*k3 + k4))$
dmap : ratsimp(subst(e = 0, diff(rk(x, moved), e)))$
xs : stages(x, f0)$
weighted : dt*sum(cw(dt*a)[i]*(e0 + e1*xs[i]), i, 1, 4)$
vanishes("(1) the RK4 step's derivative - dt sum_i c_i (e0 + e1 x_i)", ratsimp(dmap - weighted))$
vanishes("(1) sum_i c_i - S", ratsimp(sum(cw(z)[i], i, 1, 4) - S(z)))$

/* (2) */
start : dt*S(dt*a)*(e0 + e1*x)$
vanishes("(2) the start's read's gap - dt^2 S'(z) e1 f(x)",
         ratsimp(dmap - start - dt^2*Sp(dt*a)*e1*(a*x + q)))$
vanishes("(2) S' - dS/dz", ratsimp(Sp(z) - diff(S(z), z)))$
holds("(2) S'(0) = 1/2", is(Sp(0) = 1/2))$
vanishes("(2) no gap where the error does not move with the state",
         ratsimp(subst(e1 = 0, dmap - start)))$

/* (3) */
eul(x, fld) := x + dt*fld(x)$
vanishes("(3) the Euler map's derivative - dt (e0 + e1 x)",
         ratsimp(subst(e = 0, diff(eul(x, moved), e)) - dt*(e0 + e1*x)))$

/* (4) rk4_inherited.mac's point: theta = (c, a, b, p) on X = [1, x, u, w] */
kill(a, q, z)$
rho : [h*S(a*h)*c, R(a*h), h*S(a*h)*b, h*S(a*h)*p]$
th : [c, a, b, p]$
fld4(xx) := c + a*xx + b*u + p*w$
step4 : x + h/6*(fld4(x) + 2*fld4(x + h/2*fld4(x)) + 2*fld4(x + h/2*fld4(x + h/2*fld4(x)))
                 + fld4(x + h*fld4(x + h/2*fld4(x + h/2*fld4(x)))))$
dstep : makelist(diff(step4, th[j]), j, 1, 4)$
st4 : block([k1, k2, k3], k1 : fld4(x), k2 : fld4(x + h/2*k1), k3 : fld4(x + h/2*k2),
            [x, x + h/2*k1, x + h/2*k2, x + h*k3])$
vanishes("(4) the step's derivative - h sum_i c_i (1, x_i, u, w)",
         ratsimp(dstep - h*sum(cw(a*h)[i]*[1, st4[i], u, w], i, 1, 4)))$
vals : [h = 1, a = -7/10, b = 4/5, c = 1/10, p = 1]$
N : 9$
xd : [3/10, -1/2, 6/5, 0, -9/10, 7/10, 2/5, -1/5, 11/10]$
ws : [1, -3/2, 1/2, 2, -1, 0, -1/2, 3/2, -2]$
ns : [1/2, -1/3, 1/4, -3/5, 2/3, -1/7, 1/5, -1/2, 1/3]$
us : makelist(-1/2*xd[i] + 4/5*ws[i] + ns[i], i, 1, N)$
X : genmatrix(lambda([i, j], [1, xd[i], us[i], ws[i]][j]), N, 4)$
D : genmatrix(lambda([i, j], [1, xd[i], ws[i]][j]), N, 3)$
uc : genmatrix(lambda([i, j], us[i]), N, 1)$
XtXi : invert(transpose(X) . X)$
G : XtXi . transpose(X)$
Yrow(i) := [1 - S(a*h),
            xd[i]*(1 - Rp(a*h)) - h*Sp(a*h)*(c + b*us[i] + p*ws[i]),
            us[i]*(1 - S(a*h)),
            ws[i]*(1 - S(a*h))]$
Y : subst(vals, genmatrix(lambda([i, j], Yrow(i)[j]), N, 4))$
K : ident(4) - G . Y$
KG : invert(K) . G$
Sig : KG . transpose(KG)$
ubar : sum(us[i], i, 1, N)/N$
zv : subst(vals, a*h)$
hv : subst(vals, h)$
/* the step's error, least squares' one-step prediction's, the start's read and the stages' read
   at a state x and an action u, the push w = 0 */
reads(xv, uv) := block([at, drow, xr, st, sd, exact, oracle],
  at : append(vals, [x = xv, u = uv, w = 0]),
  drow : matrix(subst(at, dstep)),
  xr : matrix([1, xv, uv, 0]),
  vanishes("(4) the step's derivative times K^-1 G - h (1, x, u, w) (X'X)^-1 X'",
           ratsimp(drow . KG - hv*xr . XtXi . transpose(X))),
  st : subst(at, st4),
  sd : makelist(float(sqrt(matrix([1, st[i], uv, 0]) . Sig . transpose(matrix([1, st[i], uv, 0])))),
                i, 1, 4),
  exact : float(sqrt(drow . Sig . transpose(drow))),
  oracle : float(sqrt(hv^2*(xr . XtXi . transpose(xr)))),
  [exact, oracle, float(hv*S(zv)*sd[1]), float(hv*sum(cw(zv)[i]*sd[i], i, 1, 4)), float(st)])$
for point in [[2, ubar], [0, 2], [-1, -2]] do block([r : apply(reads, point)],
  print("(4) at x =", point[1], ", u =", float(point[2]), ", h a = -0.7: the step's error", r[1],
        " least squares'", r[2], " the start's read", r[3], " the stages'", r[4],
        " the stages' states", r[5]),
  print("(4)   the start's read over the step's error", r[3]/r[1], " the stages'", r[4]/r[1]),
  holds("(4)   the oracle agrees", is(abs(r[1] - r[2]) < 1e-12*r[2])),
  holds("(4)   the stages' read bounds the step's error and is within 2 % of it",
        is(r[1] <= r[4]) and is(r[4] < 1.02*r[1])),
  holds("(4)   the start's read is off it by more than 5 %", is(abs(r[3]/r[1] - 1) > 0.05)))$
print("(4) the stages' weights at h a = -0.7", float(cw(zv)))$
ubar : sum(us[i], i, 1, N)/N$
st4v : subst(append(vals, [x = 2, u = ubar, w = 0]), st4)$
Hst(i) := matrix([1, st4v[i], ubar, 0])$
/* ADR 0133's decomposition at each stage's state: the inherited and the cross terms are read at
   every stage */
ri : [1, 2, 4]$
W : invert(transpose(D) . D) . transpose(D)$
Yr : genmatrix(lambda([i, j], Y[i, ri[j]]), N, 3)$
Krr : ident(3) - W . Yr$
Gam : W . uc$
KGb : row(KG, 3)$
Ss : subst(vals, S(a*h))$
Vb : KGb . transpose(KGb)$
for i : 1 thru 4 do block([phi, L, Vcond, cross, Vfull],
  phi : matrix([1, st4v[i], 0]),
  Vfull : Hst(i) . Sig . transpose(Hst(i)),
  Vcond : phi . invert(Krr) . invert(transpose(D) . D) . transpose(invert(Krr)) . transpose(phi),
  L : ubar - (phi . invert(Krr) . (Ss*Gam)),
  cross : phi . invert(Krr) . W . transpose(KGb),
  vanishes(sconcat("(4) stage ", i, ": V_full - (V_cond + L^2 V_b + 2 L cross)"),
           ratsimp(Vfull - (Vcond + L^2*Vb + 2*L*cross))))$

/* (5) two states, a matrix carry G and stage weights of a matrix z */
op2(m) := lmax(map(lambda([v], float(v)), eigenvalues_list(transpose(m) . m)))$
eigenvalues_list(m) := block([ev : eigenvalues(m)], flatten(makelist(
  makelist(ev[1][i], j, 1, ev[2][i]), i, 1, length(ev[1]))))$
Z : matrix([-1/5, 1/10], [0, -3/10])$
Id : ident(2)$
cm : [(Id + Z + Z . Z/2 + Z . Z . Z/4)/6, (2*Id + Z + Z . Z/2)/6, (2*Id + Z)/6, Id/6]$
Gc : matrix([9/10, 1/5], [-1/10, 4/5])$
Hs : [matrix([1, 2, 0], [0, -1, 1]), matrix([1, 9/4, 0], [0, -1, 6/5]),
      matrix([1, 11/5, 1/10], [0, -9/10, 1]), matrix([1, 5/2, 0], [1/10, -1, 3/2])]$
Sg : matrix([2, 1/2, 0], [1/2, 1, -1/4], [0, -1/4, 3/2])$
M : Gc . sum(cm[i] . Hs[i], i, 1, 4)$
left : sqrt(float(mat_trace(M . Sg . transpose(M))))$
right : sum(sqrt(op2(Gc . cm[i]))*sqrt(float(mat_trace(Hs[i] . Sg . transpose(Hs[i])))), i, 1, 4)$
print("(5) the step's error carried:", left, " the stages' read:", right)$
holds("(5) Minkowski over the stages", is(left <= right))$

/* (6) one lever; the stage states of f = a x + (b0 + b1 x) u + c, the error's H = (1, x, u, x u) */
kill(a, b, c, u, x)$
fb(xx) := a*xx + (b0 + b1*xx)*u + c$
sb : stages(x, fb)$
hb(xx) := [1, xx, u, xx*u]$
Sb : genmatrix(lambda([i, j], sg[min(i, j), max(i, j)]), 4, 4)$
var3 : expand(hb(sb[3]) . Sb . hb(sb[3]))$
/* no channel on the state: b1 = 0 and the error's H = (1, x, u) */
ha(xx) := [1, xx, u]$
Sa : genmatrix(lambda([i, j], sg[min(i, j), max(i, j)]), 3, 3)$
sa : subst(b1 = 0, sb)$
holds("(6) no channel on the state: every stage's state is affine in u",
      every(lambda([v], is(hipow(expand(v), u) <= 1)), sa))$
holds("(6) no channel on the state: each stage's variance is a quadratic in u",
      every(lambda([v], is(hipow(expand(ha(v) . Sa . ha(v)), u) = 2)), sa))$
holds("(6) a bilinear channel: the third stage's state is quadratic in u",
      is(hipow(expand(sb[3]), u) = 2))$
holds("(6) a bilinear channel: its variance is of degree 6 in u", is(hipow(var3, u) = 6))$
