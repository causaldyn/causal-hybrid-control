/* The logit dither of chc.marketplace.SharedStateMarket.generate_logs and its test,
   chc.marketplace.dither_check and dither_size (tests/test_marketplace.py). A block's rates are
   u = T*softmax(z + delta), delta = h*r, r balanced signs: n/2 of +1 and n/2 of -1, a 0 where n is
   odd, in a random order.
   STEP 1  every dither keeps the block's total T, and the first-order move is
           T*(diag(pi) - pi pi')*delta = u0*(delta - pi.delta), pi = softmax(z), u0 = T*pi
   STEP 2  the balanced signs, every order enumerated: mean 0, covariance c_n*(I - 11'/n), c_n = n/(n-1)
           where n is even (n = 4, 6 orders) and 1 where it is odd (n = 5, 30 orders)
   STEP 3  the first-order move's mean is 0 and its second moment per unit of h is
           M = c_n*D(u0)*(I - 1 pi')*(I - pi 1')*D(u0), every order at n = 4 against the closed form
   STEP 4  a plan on f(u) = g.u + u'Hu/2, H negative definite, read with the gradient g + e loses
           e'(-H)^-1 e/2, symbolically in two dimensions; at a sample point no more than
           |e|^2/(2*k), k the least eigenvalue of -H
   STEP 5  the noncentrality: the chi-square test on 11 degrees at level 0.05 has power 0.8 at
           lambda = 16.80171761828214 (the code's), by the Poisson mixture
           sum_j exp(-lambda/2)*(lambda/2)^j/j! * Q((11 + 2j)/2, c/2), c the critical value
           19.67513757268249, in 40 digits; on 1 degree lambda = 7.848860509326202, near
           (z_0.975 + z_0.8)^2
   STEP 6  the size: mde(h) = sqrt(lambda*rho/(N*h^2)) reads error at h = sqrt(lambda*rho/N)/error,
           and at a quarter of the blocks it doubles

   Run: timeout 300 maxima --very-quiet -Q -b validation/marketplace_dither.mac */

linel : 110$
display2d : false$
ratprint : false$
verdict(e) := if is(e) then "(ok)" else "(FAIL)"$

/* STEP 1 */
zz : [z1, z2, z3]$ dd : [d1, d2, d3]$
soft(v) := block([w : map(exp, v)], w/apply("+", w))$
ud : TT*soft(zz + dd)$
gap1 : ratsimp(apply("+", ud) - TT)$
print("STEP 1  the dithered rates' total less T:", gap1, verdict(equal(gap1, 0)))$
jac : genmatrix(lambda([i, j], subst([d1 = 0, d2 = 0, d3 = 0], diff(ud[i], dd[j]))), 3, 3)$
pp : soft(zz)$
move : TT*pp*(dd - pp . dd)$
gap2 : ratsimp(list_matrix_entries(jac . transpose(matrix(dd))) - move)$
print("STEP 1  the Jacobian times delta less u0*(delta - pi.delta):", gap2,
      verdict(every(lambda([e], equal(e, 0)), gap2)))$

/* STEP 2 */
orders(base) := listify(permutations(base))$
signs4 : orders([1, 1, -1, -1])$ signs5 : orders([1, 1, -1, -1, 0])$
moments(signs, n) := block([k : length(signs)],
  [apply("+", signs)/k, apply("+", map(lambda([r], transpose(matrix(r)) . matrix(r)), signs))/k])$
check_signs(signs, n, cn) := block([mm : moments(signs, n), want],
  want : cn*(ident(n) - genmatrix(lambda([i, j], 1/n), n, n)),
  [length(signs), mm[1], verdict(every(lambda([e], equal(e, 0)), mm[1])
                                  and every(lambda([e], equal(e, 0)),
                                            list_matrix_entries(mm[2] - want)))])$
print("STEP 2  n = 4: orders, mean, covariance (4/3)*(I - 11'/4):", check_signs(signs4, 4, 4/3))$
print("STEP 2  n = 5: orders, mean, covariance I - 11'/5:", check_signs(signs5, 5, 1))$

/* STEP 3 */
p4 : 1 - q1 - q2 - q3$
qq : [q1, q2, q3, p4]$
u0 : TT*qq$
lin(r) := TT*qq*(r - qq . r)$          /* the first-order move per unit of h */
mean3 : ratsimp(apply("+", map(lin, signs4))/length(signs4))$
second : apply("+", map(lambda([r], transpose(matrix(lin(r))) . matrix(lin(r))), signs4))/length(signs4)$
onepi : ident(4) - transpose(matrix([1, 1, 1, 1])) . matrix(qq)$
closed3 : (4/3)*diag_matrix(u0[1], u0[2], u0[3], u0[4]) . onepi . transpose(onepi)
          . diag_matrix(u0[1], u0[2], u0[3], u0[4])$
gap3 : ratsimp(list_matrix_entries(second - closed3))$
print("STEP 3  the move's mean over the 6 orders:", mean3, verdict(every(lambda([e], equal(e, 0)), mean3)))$
print("STEP 3  its second moment less c_n*D(u0)(I - 1 pi')(I - pi 1')D(u0):",
      verdict(every(lambda([e], equal(e, 0)), gap3)))$

/* STEP 4 */
HH : matrix([-h1, k], [k, -h2])$
gg : transpose(matrix([g1, g2]))$ ee : transpose(matrix([e1, e2]))$
f(v) := (transpose(gg) . v + transpose(v) . HH . v/2)$
best : -invert(HH) . gg$ read : -invert(HH) . (gg + ee)$
loss : ratsimp(f(best) - f(read))$
gap4 : ratsimp(loss - (transpose(ee) . invert(-HH) . ee)/2)$
print("STEP 4  the loss less e'(-H)^-1 e/2:", gap4, verdict(equal(gap4, 0)))$
at4 : [h1 = 3, h2 = 2, k = 1, e1 = 1/2, e2 = -1/3]$
kmin : lmin(map(lambda([x], float(x)), eigenvalues(subst(at4, -HH))[1]))$
l4 : float(subst(at4, (transpose(ee) . invert(-HH) . ee)/2))$
bound4 : float(subst(at4, (e1^2 + e2^2)/(2*kmin)))$
print("STEP 4  at h1 3, h2 2, k 1, e (1/2, -1/3): loss, bound:", l4, bound4, verdict(l4 <= bound4))$

/* STEP 5 */
fpprec : 40$
chi2power(df, lam, crit) := block([half : bfloat(lam)/2],
  sum(exp(-half)*half^j/factorial(j)*gamma_incomplete_regularized(bfloat((df + 2*j)/2), bfloat(crit)/2),
      j, 0, 300))$
p11 : chi2power(11, 16.80171761828214b0, 19.67513757268249b0)$
print("STEP 5  the power on 11 degrees at the code's noncentrality:", float(p11),
      verdict(abs(p11 - 0.8b0) < 1b-12))$
crit1 : 3.841458820694124b0$
p1 : chi2power(1, 7.848860509326202b0, crit1)$
zsum : (1.959963984540054b0 + 0.8416212335729143b0)^2$
print("STEP 5  on 1 degree: the power, and the noncentrality less (z_0.975 + z_0.8)^2:", float(p1),
      float(7.848860509326202b0 - zsum), verdict(abs(p1 - 0.8b0) < 1b-12 and abs(7.848860509326202b0 - zsum) < 1b-4))$

/* STEP 6 */
assume(lam > 0, rho > 0, N > 0, err > 0, h > 0)$
mde(h, N) := sqrt(lam*rho/(N*h^2))$
hstar : sqrt(lam*rho/N)/err$
gap6 : radcan(mde(hstar, N) - err)$
gap7 : radcan(sqrt(lam*rho/(N/4))/err - 2*hstar)$
print("STEP 6  mde at the size less the error; the size at N/4 less twice the size:", gap6, gap7,
      verdict(equal(gap6, 0) and equal(gap7, 0)))$
