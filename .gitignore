# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# uv / venv -- the glob, not `.venv/`: a `.venv311` sat outside it and reached the sdist
.venv*/

# hypothesis' example database is a local cache, not an input
.hypothesis/
uv.lock.bak

# tooling caches
.ruff_cache/
.pytest_cache/
.mypy_cache/
.ty_cache/

# Rocq / Coq build artifacts
*.vo
*.vok
*.vos
*.glob
.nra.cache
.*.aux
.lia.cache

# JAX / experiment artifacts
*.npz
*.pkl
outputs/
wandb/

# datasets (notebooks download to a local cache; never commit data)
data/

# docs: the built site, and what docs/build.sh executes and prints into the pages
site/
docs/output/
docs/tutorials/*
!docs/tutorials/index.md

# editors / OS
.vscode/
.idea/
.zed/
.DS_Store
.ipynb_checkpoints/
.coq-native/

# Rust runtime build artifacts
runtime/target/
*.rs.bk
